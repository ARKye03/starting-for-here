---
import { getCollection, render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => {
    // ID is like "en/slug.md" or "es/slug.md"
    const [lang, ...slugParts] = project.id.split("/");
    const slug = slugParts.join("/").replace(/\.[^/.]+$/, "");

    return {
      params: { lang, slug },
      props: { project },
    };
  });
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { project } = Astro.props;
const { Content } = await render(project);
const transitionName = `project-${Astro.params.slug ?? ""}`;
const projectImages = project.data.images || [];
---

<Layout
  title={`${project.data.title} - Portfolio`}
  currentPage="projects"
  lang={lang}
>
  <article class="mx-auto max-w-4xl py-10">
    <header class="mb-12">
      <h1
        class="mb-4 text-4xl leading-tight font-black tracking-[-0.033em] md:text-5xl"
      >
        {project.data.title}
      </h1>
      <p class="mb-6 text-xl text-gray-600 dark:text-gray-300">
        {project.data.description}
      </p>

      {
        projectImages.length > 1 ? (
          <div class="group relative mb-6">
            {/* Carousel Container */}
            <div
              id="image-carousel"
              class="no-scrollbar flex snap-x snap-mandatory overflow-x-auto scroll-smooth rounded-lg"
            >
              {projectImages.map((img, index) => (
                <div class="relative min-w-full snap-center">
                  <Image
                    src={`/projects/${img}`}
                    alt={`${project.data.title} screenshot ${index + 1} of ${projectImages.length}`}
                    class="image-fade-mask h-auto max-h-[500px] w-full object-cover"
                    width={800}
                    height={450}
                    loading={index === 0 ? "eager" : "lazy"}
                  />
                </div>
              ))}
            </div>

            {/* Navigation Buttons */}
            <button
              id="prev-slide"
              class="absolute top-1/2 left-4 -translate-y-1/2 rounded-full bg-black/50 p-2 text-white opacity-0 backdrop-blur-sm transition-opacity group-hover:opacity-100 hover:bg-black/70 disabled:opacity-0"
              aria-label="Previous image"
            >
              <Icon name="chevron-left" class="h-6 w-6" />
            </button>
            <button
              id="next-slide"
              class="absolute top-1/2 right-4 -translate-y-1/2 rounded-full bg-black/50 p-2 text-white opacity-0 backdrop-blur-sm transition-opacity group-hover:opacity-100 hover:bg-black/70 disabled:opacity-0"
              aria-label="Next image"
            >
              <Icon name="chevron-right" class="h-6 w-6" />
            </button>

            {/* Pagination Dots */}
            <div class="absolute bottom-4 left-1/2 flex -translate-x-1/2 gap-2">
              {projectImages.map((_, index) => (
                <button
                  class="carousel-dot h-2 w-2 rounded-full bg-white/50 transition-colors hover:bg-white/90"
                  data-index={index}
                  aria-label={`Go to slide ${index + 1}`}
                />
              ))}
            </div>
          </div>
        ) : projectImages.length === 1 ? (
          <div class="mb-6 overflow-hidden rounded-lg">
            <Image
              src={`/projects/${projectImages[0]}`}
              alt={`${project.data.title} screenshot`}
              class="image-fade-mask h-auto w-full object-cover transition-transform duration-300 hover:scale-105"
              transition:name={transitionName}
              width={800}
              height={400}
              loading="eager"
            />
          </div>
        ) : null
      }

      {
        project.data.tags && project.data.tags.length > 0 && (
          <div class="mb-6 flex flex-wrap gap-2">
            {project.data.tags.map((tag) => (
              <span class="bg-primary/10 text-primary rounded-full px-3 py-1 text-sm">
                {tag}
              </span>
            ))}
          </div>
        )
      }

      <div class="flex gap-4">
        {
          project.data.url && (
            <a
              href={project.data.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary flex items-center gap-2 text-sm font-medium hover:underline"
            >
              <span>🔗</span>
              {t("project.viewLive")}
            </a>
          )
        }
        {
          project.data.github && (
            <a
              href={project.data.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary flex items-center gap-2 text-sm font-medium hover:underline"
            >
              <span>💻</span>
              {t("project.viewGitHub")}
            </a>
          )
        }
      </div>
    </header>

    <div class="prose prose-lg dark:prose-invert max-w-none">
      <Content />
    </div>

    <div class="mt-12 border-t border-gray-200 pt-8 dark:border-gray-700">
      <a
        href={`/${lang}/projects`}
        class="text-primary inline-flex items-center gap-2 font-medium hover:underline"
      >
        <span>←</span>
        {t("project.backToProjects")}
      </a>
    </div>
  </article>
</Layout>

<script>
  function setupCarousel() {
    const container = document.getElementById("image-carousel");
    if (!container) return;

    const prevBtn = document.getElementById("prev-slide");
    const nextBtn = document.getElementById("next-slide");
    const dots = document.querySelectorAll(".carousel-dot");

    // Scroll to previous slide
    prevBtn?.addEventListener("click", () => {
      container.scrollBy({
        left: -container.clientWidth,
        behavior: "smooth",
      });
    });

    // Scroll to next slide
    nextBtn?.addEventListener("click", () => {
      container.scrollBy({
        left: container.clientWidth,
        behavior: "smooth",
      });
    });

    // Pagination dots
    dots.forEach((dot) => {
      dot.addEventListener("click", (e) => {
        const index = parseInt((e.target as HTMLElement).dataset.index || "0");
        const scrollAmount = index * container.clientWidth;
        container.scrollTo({ left: scrollAmount, behavior: "smooth" });
      });
    });

    // Update active dot and button state on scroll
    const updateState = () => {
      const index = Math.round(container.scrollLeft / container.clientWidth);

      // Update dots
      dots.forEach((dot, i) => {
        if (i === index) {
          dot.classList.remove("bg-white/50");
          dot.classList.add("bg-white");
        } else {
          dot.classList.add("bg-white/50");
          dot.classList.remove("bg-white");
        }
      });
    };

    container.addEventListener("scroll", updateState);

    // Initial update
    updateState();
  }

  // Run on initial load and after view transitions
  document.addEventListener("astro:page-load", setupCarousel);
</script>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .image-fade-mask {
    mask-image: linear-gradient(to top, transparent 0%, black 20%);
    -webkit-mask-image: linear-gradient(to top, transparent 0%, black 20%);
  }
</style>
