---
import { getCollection, render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => {
    const [lang, ...slugParts] = project.id.split("/");
    const slug = slugParts.join("/").replace(/\.[^/.]+$/, "");

    return {
      params: { lang, slug },
      props: { project },
    };
  });
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { project } = Astro.props;
const { Content } = await render(project);
const transitionName = `project-${Astro.params.slug ?? ""}`;
const projectImages = project.data.images || [];
const dateStr = project.data.date.toLocaleDateString(
  lang === "es" ? "es-ES" : "en-US",
  { year: "numeric", month: "short" },
);
---

<Layout
  title={`${project.data.title} - Portfolio`}
  description={project.data.description}
  currentPage="projects"
  lang={lang}
>
  <article class="relative px-6 pt-24 pb-20 md:pt-28">
    <div class="mx-auto max-w-[900px]">
      <a
        href={`/${lang}/projects`}
        class="nav-link mb-8 inline-flex items-center gap-1.5"
      >
        <Icon name="arrow-left" class="h-3.5 w-3.5" />
        {t("project.backToProjects")}
      </a>

      <header class="mb-10">
        <div
          class="mb-2 font-mono text-[11px] tracking-[0.1em] uppercase"
          style="color: var(--muted-foreground); opacity: 0.5"
        >
          {dateStr}
        </div>
        <h1
          class="display-h1 mb-3"
          style="font-size: clamp(2rem, 5vw, 3.25rem)"
          transition:name={transitionName}
        >
          {project.data.title}
        </h1>
        <p
          class="mb-6 max-w-[640px] text-[17px] leading-[1.6]"
          style="color: var(--muted-foreground); font-family: var(--font-body)"
        >
          {project.data.description}
        </p>

        {
          project.data.tags && project.data.tags.length > 0 && (
            <div class="mb-6 flex flex-wrap gap-1.5">
              {project.data.tags.map((tag) => (
                <span
                  class="tag"
                  style="font-size: 0.6875rem; padding: 0.25rem 0.75rem"
                >
                  {tag}
                </span>
              ))}
            </div>
          )
        }

        <div class="flex flex-wrap gap-3">
          {
            project.data.url && (
              <a
                href={project.data.url}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-outline btn-mono inline-flex items-center gap-2"
              >
                <Icon name="arrow-up-right" class="h-4 w-4" />
                {t("project.viewLive")}
              </a>
            )
          }
          {
            project.data.github && (
              <a
                href={project.data.github}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-outline btn-mono inline-flex items-center gap-2"
              >
                <Icon name="github" class="h-4 w-4" />
                {t("project.viewGitHub")}
              </a>
            )
          }
        </div>
      </header>

      {
        projectImages.length >= 1 && (
          <div class="carousel-wrap relative mb-12">
            <div
              id="image-carousel"
              class="no-scrollbar flex snap-x snap-mandatory overflow-x-auto scroll-smooth"
            >
              {projectImages.map((img, index) => (
                <div class="relative min-w-full snap-center">
                  <Image
                    src={`/projects/${img}`}
                    alt={`${project.data.title} screenshot ${index + 1} of ${projectImages.length}`}
                    class="h-auto max-h-[540px] w-full object-cover"
                    width={900}
                    height={506}
                    loading={index === 0 ? "eager" : "lazy"}
                  />
                </div>
              ))}
            </div>

            {projectImages.length > 1 && (
              <>
                <button
                  id="prev-slide"
                  class="carousel-btn prev"
                  aria-label="Previous image"
                >
                  <Icon name="chevron-left" class="h-4 w-4" />
                </button>
                <button
                  id="next-slide"
                  class="carousel-btn next"
                  aria-label="Next image"
                >
                  <Icon name="chevron-right" class="h-4 w-4" />
                </button>

                <div class="carousel-dots">
                  {projectImages.map((_, index) => (
                    <button
                      class:list={[
                        "carousel-dot",
                        { "is-active": index === 0 },
                      ]}
                      data-index={index}
                      aria-label={`Go to slide ${index + 1}`}
                    />
                  ))}
                </div>
              </>
            )}
          </div>
        )
      }

      <div class="prose dark:prose-invert max-w-none">
        <Content />
      </div>
    </div>
  </article>
</Layout>

<style>
  .carousel-wrap {
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--card);
    border: 1px solid var(--border);
  }

  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 40px;
    height: 40px;
    border-radius: 9999px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--foreground);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    backdrop-filter: blur(8px);
    opacity: 0;
  }
  .carousel-wrap:hover .carousel-btn {
    opacity: 1;
  }
  .carousel-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
  }
  .carousel-btn.prev {
    left: 12px;
  }
  .carousel-btn.next {
    right: 12px;
  }

  .carousel-dots {
    position: absolute;
    bottom: 12px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 6px;
    padding: 8px 12px;
    border-radius: 9999px;
    background: color-mix(in oklch, var(--background) 70%, transparent);
    backdrop-filter: blur(8px);
  }
  .carousel-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--border);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.2s;
  }
  .carousel-dot.is-active {
    background: var(--primary);
    width: 20px;
    border-radius: 3px;
  }
</style>

<script>
  function setupCarousel() {
    const container = document.getElementById("image-carousel");
    if (!container) return;

    const prevBtn = document.getElementById("prev-slide");
    const nextBtn = document.getElementById("next-slide");
    const dots = document.querySelectorAll<HTMLButtonElement>(".carousel-dot");

    prevBtn?.addEventListener("click", () => {
      container.scrollBy({ left: -container.clientWidth, behavior: "smooth" });
    });

    nextBtn?.addEventListener("click", () => {
      container.scrollBy({ left: container.clientWidth, behavior: "smooth" });
    });

    dots.forEach((dot) => {
      dot.addEventListener("click", (e) => {
        const target = e.currentTarget as HTMLElement;
        const index = parseInt(target.dataset.index || "0");
        container.scrollTo({
          left: index * container.clientWidth,
          behavior: "smooth",
        });
      });
    });

    const updateState = () => {
      const index = Math.round(container.scrollLeft / container.clientWidth);
      dots.forEach((dot, i) => {
        dot.classList.toggle("is-active", i === index);
      });
    };

    container.addEventListener("scroll", updateState);
    updateState();
  }

  document.addEventListener("astro:page-load", setupCarousel);
</script>
