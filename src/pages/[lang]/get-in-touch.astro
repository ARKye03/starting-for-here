---
import Layout from "../../layouts/Layout.astro";
import { languages } from "../../i18n/ui";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { buttonVariants } from "@assets/components/ui/button";
import { cn } from "@assets/lib/utils";
import { Mail, MessagesSquare } from "lucide-react";

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
let email = "rafa03-dev@proton.me";

// Shadcn input styles
const inputClasses =
  "file:text-foreground placeholder:text-muted-foreground selection:bg-primary selection:text-primary-foreground dark:bg-input/30 border-input h-10 w-full min-w-0 rounded-md border bg-transparent px-3 py-2 text-base shadow-xs transition-[color,box-shadow] outline-none file:inline-flex file:h-7 file:border-0 file:bg-transparent file:text-sm file:font-medium disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50 md:text-sm focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive";

const textareaClasses =
  "border-input placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-ring/50 aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive dark:bg-input/30 flex field-sizing-content min-h-24 w-full rounded-md border bg-transparent px-3 py-2 text-base shadow-xs transition-[color,box-shadow] outline-none focus-visible:ring-[3px] disabled:cursor-not-allowed disabled:opacity-50 md:text-sm";

const labelClasses = "text-sm font-medium leading-none pb-2";
---

<Layout title={t("page.contact.title")} currentPage="contact" lang={lang}>
  <div class="mx-auto max-w-7xl px-6 py-16 sm:py-24 lg:px-8">
    <div class="flex flex-col gap-16 lg:flex-row lg:gap-24">
      <div class="space-y-8 lg:w-2/5">
        <div>
          <h1
            class="text-foreground mb-4 text-4xl font-black tracking-tighter sm:text-5xl"
          >
            {t("contact.heading")}
          </h1>
          <p class="text-muted-foreground text-lg">
            {t("contact.description")}
          </p>
        </div>

        <div class="flex items-start gap-4">
          <div
            class="bg-primary/10 text-primary flex h-12 w-12 items-center justify-center rounded-lg"
          >
            <Mail />
          </div>
          <div>
            <p class="text-foreground font-semibold">
              {t("contact.email")}
            </p>
            <a
              class="text-muted-foreground hover:text-primary transition-colors"
              href={`mailto:${email}`}>{email}</a
            >
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div
            class="bg-primary/10 text-primary flex h-12 w-12 items-center justify-center rounded-lg"
          >
            <MessagesSquare />
          </div>
          <div>
            <p class="text-foreground font-semibold">
              {t("contact.social")}
            </p>
            <div class="flex gap-4">
              <a
                class="text-muted-foreground hover:text-primary transition-colors"
                href="https://www.linkedin.com/in/rafa03-dev">LinkedIn</a
              >
              <a
                class="text-muted-foreground hover:text-primary transition-colors"
                href="https://github.com/ARKye03">GitHub</a
              >
              <a
                class="text-muted-foreground hover:text-primary transition-colors"
                href="https://x.com/RafaelzSanchez">Twitter</a
              >
            </div>
          </div>
        </div>
      </div>

      <form
        id="contact-form"
        class="space-y-6 lg:w-3/5"
        action="/api/contact"
        method="POST"
        data-msg-sending={t("contact.form.sending")}
        data-msg-submit={t("contact.form.submit")}
        data-msg-success={t("contact.form.success")}
        data-msg-error={t("contact.form.error")}
        data-msg-network={t("contact.form.networkError")}
      >
        <!-- Status messages -->
        <div id="form-status" class="hidden rounded-lg p-4"></div>

        <div>
          <label class={labelClasses} for="name">{t("contact.form.name")}</label
          >
          <input
            autocomplete="name"
            class={inputClasses}
            id="name"
            name="name"
            placeholder={t("contact.form.namePlaceholder")}
            type="text"
            required
          />
        </div>
        <div>
          <label class={labelClasses} for="email"
            >{t("contact.form.email")}</label
          >
          <input
            autocomplete="email"
            class={inputClasses}
            id="email"
            name="email"
            placeholder={t("contact.form.emailPlaceholder")}
            type="email"
            required
          />
        </div>
        <div>
          <label class={labelClasses} for="subject"
            >{t("contact.form.subject")}</label
          >
          <input
            class={inputClasses}
            id="subject"
            name="subject"
            placeholder={t("contact.form.subjectPlaceholder")}
            type="text"
            required
          />
        </div>
        <div>
          <label class={labelClasses} for="message"
            >{t("contact.form.message")}</label
          >
          <textarea
            class={textareaClasses}
            id="message"
            name="message"
            placeholder={t("contact.form.messagePlaceholder")}
            rows="4"
            required></textarea>
        </div>
        <button
          id="submit-btn"
          class={cn(
            buttonVariants({ variant: "default", size: "default" }),
            "w-full",
          )}
          type="submit"
        >
          <span id="btn-text">{t("contact.form.submit")}</span>
        </button>
      </form>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const statusDiv = document.getElementById("form-status");
    const submitBtn = document.getElementById(
      "submit-btn",
    ) as HTMLButtonElement;
    const btnText = document.getElementById("btn-text");

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();

      submitBtn.disabled = true;
      if (btnText)
        btnText.textContent = form.dataset.msgSending || "Sending...";

      try {
        const formData = new FormData(form);
        const response = await fetch("/api/contact", {
          method: "POST",
          body: formData,
        });

        const result = await response.json();

        if (response.ok) {
          if (statusDiv) {
            statusDiv.className =
              "rounded-lg p-4 bg-green-500/10 text-green-600 dark:text-green-400 border border-green-500/20";
            statusDiv.textContent = form.dataset.msgSuccess || "✓ Success";
            statusDiv.classList.remove("hidden");
          }
          form.reset();
        } else {
          if (statusDiv) {
            statusDiv.className =
              "rounded-lg p-4 bg-destructive/10 text-destructive border border-destructive/20";
            statusDiv.textContent = `✗ ${result.error || form.dataset.msgError || "Error"}`;
            statusDiv.classList.remove("hidden");
          }
        }
      } catch {
        if (statusDiv) {
          statusDiv.className =
            "rounded-lg p-4 bg-destructive/10 text-destructive border border-destructive/20";
          statusDiv.textContent = form.dataset.msgNetwork || "✗ Network error";
          statusDiv.classList.remove("hidden");
        }
      } finally {
        submitBtn.disabled = false;
        if (btnText)
          btnText.textContent = form.dataset.msgSubmit || "Send Message";

        setTimeout(() => {
          statusDiv?.classList.add("hidden");
        }, 5000);
      }
    });
  });
</script>
