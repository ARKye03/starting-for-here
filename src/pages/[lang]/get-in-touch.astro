---
import Layout from "../../layouts/Layout.astro";
import { languages } from "../../i18n/ui";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const email = "rafa03-dev@proton.me";
---

<Layout
  title={t("page.contact.title")}
  description={t("contact.description")}
  currentPage="contact"
  lang={lang}
>
  <section class="px-6 pt-24 pb-20 md:pt-32">
    <div class="mx-auto max-w-[1120px]">
      <div class="mb-12">
        <div class="section-label mb-3">{t("section.contact")}</div>
        <h1 class="display-h1 mb-3" style="font-size: clamp(2rem, 5vw, 3rem)">
          {t("contact.heading")}
        </h1>
        <p
          class="max-w-[640px] text-base"
          style="color: var(--muted-foreground); font-family: var(--font-body)"
        >
          {t("contact.description")}
        </p>
      </div>

      <div class="grid gap-12 md:grid-cols-[1fr_320px] md:gap-16">
        <form
          id="contact-form"
          class="flex flex-col gap-5"
          action="/api/contact"
          method="POST"
          data-msg-sending={t("contact.form.sending")}
          data-msg-submit={t("contact.form.submit")}
          data-msg-success={t("contact.form.success")}
          data-msg-error={t("contact.form.error")}
          data-msg-network={t("contact.form.networkError")}
          data-msg-missing-fields={t("contact.form.errorMissing")}
          data-msg-invalid-email={t("contact.form.errorEmail")}
          data-msg-too-long={t("contact.form.errorTooLong")}
        >
          <div
            id="form-status"
            class="hidden rounded-[var(--radius)] p-3 text-sm"
          >
          </div>

          <!-- Honeypot: hidden from humans, bots fill it -->
          <input
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            class="hp-field"
          />

          <div class="grid gap-4 sm:grid-cols-2">
            <label class="flex flex-col gap-1.5">
              <span class="form-label">{t("contact.form.name")}</span>
              <input
                autocomplete="name"
                class="form-input"
                id="name"
                name="name"
                placeholder={t("contact.form.namePlaceholder")}
                type="text"
                required
              />
            </label>

            <label class="flex flex-col gap-1.5">
              <span class="form-label">{t("contact.form.email")}</span>
              <input
                autocomplete="email"
                class="form-input"
                id="email"
                name="email"
                placeholder={t("contact.form.emailPlaceholder")}
                type="email"
                required
              />
            </label>
          </div>

          <label class="flex flex-col gap-1.5">
            <span class="form-label">{t("contact.form.subject")}</span>
            <input
              class="form-input"
              id="subject"
              name="subject"
              placeholder={t("contact.form.subjectPlaceholder")}
              type="text"
              required
            />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="form-label">{t("contact.form.message")}</span>
            <textarea
              class="form-input"
              id="message"
              name="message"
              placeholder={t("contact.form.messagePlaceholder")}
              rows="5"
              required></textarea>
          </label>

          <button
            id="submit-btn"
            class="btn btn-primary btn-mono inline-flex items-center gap-2 self-start"
            type="submit"
          >
            <span id="btn-text">{t("contact.form.submit")}</span>
            <Icon name="arrow-right" class="h-4 w-4" />
          </button>
        </form>

        <aside class="flex flex-col gap-8">
          <div>
            <h4 class="form-label mb-3">{t("contact.email")}</h4>
            <a
              href={`mailto:${email}`}
              class="text-[15px] no-underline hover:underline"
              style="color: var(--primary); font-family: var(--font-body)"
            >
              {email}
            </a>
          </div>
          <div>
            <h4 class="form-label mb-3">{t("contact.social")}</h4>
            <div class="flex flex-col gap-2.5">
              <a
                href="https://github.com/ARKye03"
                target="_blank"
                rel="noopener noreferrer"
                class="contact-link"
              >
                <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
                GitHub
              </a>
              <a
                href="https://www.linkedin.com/in/rafa03-dev"
                target="_blank"
                rel="noopener noreferrer"
                class="contact-link"
              >
                <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
                LinkedIn
              </a>
              <a
                href="https://x.com/RafaelzSanchez"
                target="_blank"
                rel="noopener noreferrer"
                class="contact-link"
              >
                <Icon name="arrow-up-right" class="h-3.5 w-3.5" />
                Twitter
              </a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<style>
  .form-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .form-input {
    font-family: var(--font-body);
    font-size: 0.875rem;
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--input);
    color: var(--foreground);
    outline: none;
    transition: border-color 0.2s;
    width: 100%;
  }
  .form-input:focus {
    border-color: var(--primary);
  }
  .form-input::placeholder {
    color: var(--muted-foreground);
    opacity: 0.5;
  }
  textarea.form-input {
    resize: vertical;
    min-height: 8rem;
  }
  .contact-link {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--foreground);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: color 0.2s;
  }
  .contact-link:hover {
    color: var(--primary);
  }
  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById(
      "contact-form",
    ) as HTMLFormElement | null;
    if (!form) return;
    const statusDiv = document.getElementById("form-status");
    const submitBtn = document.getElementById(
      "submit-btn",
    ) as HTMLButtonElement;
    const btnText = document.getElementById("btn-text");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      if (btnText)
        btnText.textContent = form.dataset.msgSending || "Sending...";

      try {
        const response = await fetch("/api/contact", {
          method: "POST",
          body: new FormData(form),
        });
        const result = await response.json();

        if (statusDiv) {
          if (response.ok) {
            statusDiv.className = "rounded-[var(--radius)] p-3 text-sm border";
            statusDiv.style.borderColor = "var(--primary)";
            statusDiv.style.color = "var(--primary)";
            statusDiv.style.background =
              "color-mix(in oklch, var(--primary) 8%, transparent)";
            statusDiv.textContent = form.dataset.msgSuccess || "✓ Sent!";
            form.reset();
          } else {
            const errorMessages: Record<string, string | undefined> = {
              missing_fields: form.dataset.msgMissingFields,
              invalid_email: form.dataset.msgInvalidEmail,
              too_long: form.dataset.msgTooLong,
            };
            statusDiv.className = "rounded-[var(--radius)] p-3 text-sm border";
            statusDiv.style.borderColor = "var(--destructive)";
            statusDiv.style.color = "var(--destructive)";
            statusDiv.style.background = "transparent";
            statusDiv.textContent =
              errorMessages[result.error] || form.dataset.msgError || "✗ Error";
          }
        }
      } catch {
        if (statusDiv) {
          statusDiv.className = "rounded-[var(--radius)] p-3 text-sm border";
          statusDiv.style.borderColor = "var(--destructive)";
          statusDiv.style.color = "var(--destructive)";
          statusDiv.style.background = "transparent";
          statusDiv.textContent = form.dataset.msgNetwork || "✗ Network error";
        }
      } finally {
        submitBtn.disabled = false;
        if (btnText)
          btnText.textContent = form.dataset.msgSubmit || "Send Message";
        setTimeout(() => {
          if (statusDiv) {
            statusDiv.className = "hidden rounded-[var(--radius)] p-3 text-sm";
          }
        }, 5000);
      }
    });
  });
</script>
