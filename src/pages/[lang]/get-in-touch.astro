---
import Layout from "../../layouts/Layout.astro";
import { languages } from "../../i18n/ui";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
let email = "rafa03-dev@proton.me";
---

<Layout
  title={t("page.contact.title")}
  description={t("contact.description")}
  currentPage="contact"
  lang={lang}
>
  <div class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
    <div class="flex flex-col gap-16 lg:flex-row lg:gap-20">

      <!-- Left: contact info -->
      <aside class="flex flex-col gap-8 lg:w-2/5">
        <div>
          <h1 class="text-foreground mb-3 text-4xl font-black tracking-tighter sm:text-5xl">
            {t("contact.heading")}
          </h1>
          <p class="text-muted-foreground text-base leading-relaxed">
            {t("contact.description")}
          </p>
        </div>

        <div class="flex flex-col gap-5">
          <div class="flex items-start gap-4">
            <div class="bg-primary/10 text-primary flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-primary/20">
              <Icon name="mail" class="h-5 w-5" />
            </div>
            <div>
              <p class="text-foreground text-sm font-semibold uppercase tracking-widest">
                {t("contact.email")}
              </p>
              <a
                class="text-muted-foreground hover:text-primary text-sm transition-colors"
                href={`mailto:${email}`}>{email}</a
              >
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="bg-primary/10 text-primary flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-primary/20">
              <Icon name="messages-square" class="h-5 w-5" />
            </div>
            <div>
              <p class="text-foreground text-sm font-semibold uppercase tracking-widest">
                {t("contact.social")}
              </p>
              <div class="flex flex-wrap gap-3">
                <a class="text-muted-foreground hover:text-primary text-sm transition-colors" href="https://www.linkedin.com/in/rafa03-dev">LinkedIn</a>
                <a class="text-muted-foreground hover:text-primary text-sm transition-colors" href="https://github.com/ARKye03">GitHub</a>
                <a class="text-muted-foreground hover:text-primary text-sm transition-colors" href="https://x.com/RafaelzSanchez">Twitter</a>
              </div>
            </div>
          </div>
        </div>
      </aside>

      <!-- Right: form -->
      <form
        id="contact-form"
        class="flex flex-col gap-4 lg:w-3/5"
        action="/api/contact"
        method="POST"
        data-msg-sending={t("contact.form.sending")}
        data-msg-submit={t("contact.form.submit")}
        data-msg-success={t("contact.form.success")}
        data-msg-error={t("contact.form.error")}
        data-msg-network={t("contact.form.networkError")}
      >
        <div id="form-status" class="hidden rounded-lg p-3 text-sm"></div>

        <!-- Name + Email row -->
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <fieldset class="fieldset">
            <legend class="fieldset-legend">{t("contact.form.name")}</legend>
            <label class="input input-neutral w-full bg-base-200 border-base-300">
              <Icon name="user" class="h-[1em] opacity-50" />
              <input
                autocomplete="name"
                class="grow"
                id="name"
                name="name"
                placeholder={t("contact.form.namePlaceholder")}
                type="text"
                required
              />
            </label>
          </fieldset>

          <fieldset class="fieldset">
            <legend class="fieldset-legend">{t("contact.form.email")}</legend>
            <label class="input input-neutral w-full bg-base-200 border-base-300">
              <Icon name="mail" class="h-[1em] opacity-50" />
              <input
                autocomplete="email"
                class="grow"
                id="email"
                name="email"
                placeholder={t("contact.form.emailPlaceholder")}
                type="email"
                required
              />
            </label>
          </fieldset>
        </div>

        <fieldset class="fieldset">
          <legend class="fieldset-legend">{t("contact.form.subject")}</legend>
          <label class="input input-neutral w-full bg-base-200 border-base-300">
            <Icon name="tag" class="h-[1em] opacity-50" />
            <input
              class="grow"
              id="subject"
              name="subject"
              placeholder={t("contact.form.subjectPlaceholder")}
              type="text"
              required
            />
          </label>
        </fieldset>

        <fieldset class="fieldset">
          <legend class="fieldset-legend">{t("contact.form.message")}</legend>
          <textarea
            class="textarea textarea-neutral w-full min-h-32 resize-y bg-base-200 border-base-300"
            id="message"
            name="message"
            placeholder={t("contact.form.messagePlaceholder")}
            required></textarea>
        </fieldset>

        <button
          id="submit-btn"
          class="btn btn-primary self-start gap-2 px-8"
          type="submit"
        >
          <span id="btn-text">{t("contact.form.submit")}</span>
          <Icon name="mail" class="h-4 w-4" />
        </button>
      </form>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const statusDiv = document.getElementById("form-status");
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
    const btnText = document.getElementById("btn-text");

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      if (btnText) btnText.textContent = form.dataset.msgSending || "Sending...";

      try {
        const response = await fetch("/api/contact", {
          method: "POST",
          body: new FormData(form),
        });
        const result = await response.json();

        if (statusDiv) {
          if (response.ok) {
            statusDiv.className = "rounded-lg p-3 text-sm bg-success/10 text-success border border-success/20";
            statusDiv.textContent = form.dataset.msgSuccess || "✓ Sent!";
            form.reset();
          } else {
            statusDiv.className = "rounded-lg p-3 text-sm bg-error/10 text-error border border-error/20";
            statusDiv.textContent = `✗ ${result.error || form.dataset.msgError || "Error"}`;
          }
        }
      } catch {
        if (statusDiv) {
          statusDiv.className = "rounded-lg p-3 text-sm bg-error/10 text-error border border-error/20";
          statusDiv.textContent = form.dataset.msgNetwork || "✗ Network error";
        }
      } finally {
        submitBtn.disabled = false;
        if (btnText) btnText.textContent = form.dataset.msgSubmit || "Send Message";
        setTimeout(() => {
          if (statusDiv) statusDiv.className = "hidden rounded-lg p-3 text-sm";
        }, 5000);
      }
    });
  });
</script>
