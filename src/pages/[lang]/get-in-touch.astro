---
import Layout from "../../layouts/Layout.astro";
import { languages } from "../../i18n/ui";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

export async function getStaticPaths() {
    return Object.keys(languages).map((lang) => ({
        params: { lang },
    }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
let email = "rafa03-dev@proton.me";
---

<Layout title={t("page.contact.title")} currentPage="contact" lang={lang}>
    <div class="mx-auto max-w-7xl px-6 lg:px-8 py-16 sm:py-24">
        <div class="flex flex-col gap-16 lg:flex-row lg:gap-24">
            <div class="lg:w-2/5 space-y-8">
                <div>
                    <h1
                        class="text-4xl font-black tracking-tighter sm:text-5xl text-gray-900 dark:text-white mb-4"
                    >
                        {t("contact.heading")}
                    </h1>
                    <p class="text-lg text-gray-600 dark:text-gray-400">
                        {t("contact.description")}
                    </p>
                </div>

                <div class="flex items-start gap-4">
                    <div
                        class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary-10 text-primary"
                    >
                        <span class="text-xl">✉</span>
                    </div>
                    <div>
                        <p class="font-semibold text-gray-900 dark:text-white">
                            {t("contact.email")}
                        </p>
                        <a
                            class="text-gray-600 dark:text-gray-400 hover:text-primary dark:hover:text-primary"
                            href={`mailto:${email}`}>{email}</a
                        >
                    </div>
                </div>

                <div class="flex items-start gap-4">
                    <div
                        class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary-10 text-primary"
                    >
                        <span class="text-xl">🌐</span>
                    </div>
                    <div>
                        <p class="font-semibold text-gray-900 dark:text-white">
                            {t("contact.social")}
                        </p>
                        <div class="flex gap-4">
                            <a
                                class="text-gray-600 dark:text-gray-400 hover:text-primary dark:hover:text-primary"
                                href="https://www.linkedin.com/in/rafa03-dev"
                                >LinkedIn</a
                            >
                            <a
                                class="text-gray-600 dark:text-gray-400 hover:text-primary dark:hover:text-primary"
                                href="https://github.com/ARKye03">GitHub</a
                            >
                            <a
                                class="text-gray-600 dark:text-gray-400 hover:text-primary dark:hover:text-primary"
                                href="https://x.com/RafaelzSanchez">Twitter</a
                            >
                        </div>
                    </div>
                </div>
            </div>

            <form
                id="contact-form"
                class="lg:w-3/5 space-y-6"
                action="/api/contact"
                method="POST"
                data-msg-sending={t("contact.form.sending")}
                data-msg-submit={t("contact.form.submit")}
                data-msg-success={t("contact.form.success")}
                data-msg-error={t("contact.form.error")}
                data-msg-network={t("contact.form.networkError")}
            >
                <!-- Status messages -->
                <div id="form-status" class="hidden rounded-lg p-4"></div>

                <div>
                    <label
                        class="block text-sm font-medium leading-6 text-gray-900 dark:text-white pb-2"
                        for="name">{t("contact.form.name")}</label
                    >
                    <input
                        autocomplete="name"
                        class="form-input block w-full rounded-lg border-0 bg-gray-200 dark:bg-[#211c26] px-4 py-3.5 text-gray-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-[#473c53] placeholder:text-gray-400 dark:placeholder:text-[#ab9db8] focus:ring-2 focus:ring-inset focus:ring-primary"
                        id="name"
                        name="name"
                        placeholder={t("contact.form.namePlaceholder")}
                        type="text"
                        required
                    />
                </div>
                <div>
                    <label
                        class="block text-sm font-medium leading-6 text-gray-900 dark:text-white pb-2"
                        for="email">{t("contact.form.email")}</label
                    >
                    <input
                        autocomplete="email"
                        class="form-input block w-full rounded-lg border-0 bg-gray-200 dark:bg-[#211c26] px-4 py-3.5 text-gray-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-[#473c53] placeholder:text-gray-400 dark:placeholder:text-[#ab9db8] focus:ring-2 focus:ring-inset focus:ring-primary"
                        id="email"
                        name="email"
                        placeholder={t("contact.form.emailPlaceholder")}
                        type="email"
                        required
                    />
                </div>
                <div>
                    <label
                        class="block text-sm font-medium leading-6 text-gray-900 dark:text-white pb-2"
                        for="subject">{t("contact.form.subject")}</label
                    >
                    <input
                        class="form-input block w-full rounded-lg border-0 bg-gray-200 dark:bg-[#211c26] px-4 py-3.5 text-gray-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-[#473c53] placeholder:text-gray-400 dark:placeholder:text-[#ab9db8] focus:ring-2 focus:ring-inset focus:ring-primary"
                        id="subject"
                        name="subject"
                        placeholder={t("contact.form.subjectPlaceholder")}
                        type="text"
                        required
                    />
                </div>
                <div>
                    <label
                        class="block text-sm font-medium leading-6 text-gray-900 dark:text-white pb-2"
                        for="message">{t("contact.form.message")}</label
                    >
                    <textarea
                        class="form-textarea block w-full rounded-lg border-0 bg-gray-200 dark:bg-[#211c26] px-4 py-3.5 text-gray-900 dark:text-white shadow-sm ring-1 ring-inset ring-gray-300 dark:ring-[#473c53] placeholder:text-gray-400 dark:placeholder:text-[#ab9db8] focus:ring-2 focus:ring-inset focus:ring-primary"
                        id="message"
                        name="message"
                        placeholder={t("contact.form.messagePlaceholder")}
                        rows="4"
                        required></textarea>
                </div>
                <button
                    id="submit-btn"
                    class="flex w-full justify-center rounded-lg bg-primary px-3 py-3 text-sm font-semibold leading-6 text-white shadow-sm hover:bg-primary-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:opacity-50 disabled:cursor-not-allowed"
                    type="submit"
                >
                    <span id="btn-text">{t("contact.form.submit")}</span>
                </button>
            </form>
        </div>
    </div>
</Layout>

<script>
    document.addEventListener("astro:page-load", () => {
        const form = document.getElementById("contact-form") as HTMLFormElement;
        const statusDiv = document.getElementById("form-status");
        const submitBtn = document.getElementById(
            "submit-btn",
        ) as HTMLButtonElement;
        const btnText = document.getElementById("btn-text");

        form?.addEventListener("submit", async (e) => {
            e.preventDefault();

            submitBtn.disabled = true;
            if (btnText)
                btnText.textContent = form.dataset.msgSending || "Sending...";

            try {
                const formData = new FormData(form);
                const response = await fetch("/api/contact", {
                    method: "POST",
                    body: formData,
                });

                const result = await response.json();

                if (response.ok) {
                    if (statusDiv) {
                        statusDiv.className =
                            "rounded-lg p-4 bg-green-100 dark:bg-green-900/20 text-green-800 dark:text-green-200";
                        statusDiv.textContent =
                            form.dataset.msgSuccess || "✓ Success";
                        statusDiv.classList.remove("hidden");
                    }
                    form.reset();
                } else {
                    if (statusDiv) {
                        statusDiv.className =
                            "rounded-lg p-4 bg-red-100 dark:bg-red-900/20 text-red-800 dark:text-red-200";
                        statusDiv.textContent = `✗ ${result.error || form.dataset.msgError || "Error"}`;
                        statusDiv.classList.remove("hidden");
                    }
                }
            } catch (error) {
                if (statusDiv) {
                    statusDiv.className =
                        "rounded-lg p-4 bg-red-100 dark:bg-red-900/20 text-red-800 dark:text-red-200";
                    statusDiv.textContent =
                        form.dataset.msgNetwork || "✗ Network error";
                    statusDiv.classList.remove("hidden");
                }
            } finally {
                submitBtn.disabled = false;
                if (btnText)
                    btnText.textContent =
                        form.dataset.msgSubmit || "Send Message";

                setTimeout(() => {
                    statusDiv?.classList.add("hidden");
                }, 5000);
            }
        });
    });
</script>
