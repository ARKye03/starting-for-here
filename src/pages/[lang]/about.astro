---
import Layout from "../../layouts/Layout.astro";
import AboutHero from "@components/AboutHero.astro";
import Journey from "@components/Journey.astro";
import Skills from "@components/Skills.astro";
import Philosophy from "@components/Philosophy.astro";
import CallToAction from "@components/CallToAction.astro";
import { languages } from "../../i18n/ui";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title={t("page.about.title")}
  description={t("page.about.description")}
  currentPage="about"
  lang={lang}
>
  <AboutHero />

  <section class="px-6 py-12 md:py-20">
    <div
      class="mx-auto grid max-w-[1120px] gap-12 md:grid-cols-2 md:gap-16"
    >
      <Philosophy />
      <Journey />
    </div>
  </section>

  <Skills />
  <CallToAction />
</Layout>
