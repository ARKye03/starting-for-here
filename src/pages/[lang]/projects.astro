---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "@components/ProjectCard.astro";
import { languages } from "../../i18n/ui";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

export async function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({
    params: { lang },
  }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allProjects = await getCollection("projects");
const projects = allProjects
  .filter((project) => project.id.startsWith(`${lang}/`))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((project) => ({
    ...project,
    slug: project.id
      .split("/")
      .slice(1)
      .join("/")
      .replace(/\.[^/.]+$/, ""),
  }));

const totalCount = projects.length;
const featuredCount = projects.filter((p) => p.data.featured).length;
---

<Layout
  title={t("page.projects.title")}
  description={t("page.projects.description")}
  currentPage="projects"
  lang={lang}
>
  <div class="grid-bg-fixed"></div>

  <section class="relative px-6 pt-24 pb-20 md:pt-32">
    <div class="mx-auto max-w-[1120px]">
      <div class="mb-12">
        <div class="section-label mb-3">{t("projects.portfolioLabel")}</div>
        <h1 class="display-h1 mb-3" style="font-size: clamp(2rem, 5vw, 3rem)">
          {t("page.projects.heading")}
        </h1>
        <p
          class="mb-6 max-w-[640px] text-base"
          style="color: var(--muted-foreground); font-family: var(--font-body)"
        >
          {t("page.projects.description")}
        </p>

        <div class="flex gap-2" role="tablist" aria-label="Filter projects">
          <button
            type="button"
            class="filter-tab is-active"
            data-filter="all"
            role="tab"
          >
            {t("projects.filter.all")}
          </button>
          <button
            type="button"
            class="filter-tab"
            data-filter="featured"
            role="tab"
          >
            {t("projects.filter.featured")}
          </button>
        </div>
      </div>

      <div id="projects-grid">
        {
          projects.map((project, i) => (
            <div
              class="project-item"
              data-featured={project.data.featured ? "true" : "false"}
            >
              <ProjectCard
                title={project.data.title}
                description={project.data.description}
                slug={project.slug}
                tags={project.data.tags}
                date={project.data.date}
                featured={project.data.featured}
                index={i}
              />
            </div>
          ))
        }
      </div>

      <div
        class="mt-10 text-center font-mono text-xs"
        style="color: var(--muted-foreground); opacity: 0.6"
      >
        <span
          id="projects-count"
          data-total={totalCount}
          data-featured={featuredCount}
        >
          {totalCount}
        </span>
        {" "}{t("projects.count")}
      </div>
    </div>
  </section>
</Layout>

<style>
  .filter-tab {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 0.375rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted-foreground);
    cursor: pointer;
    transition: all 0.2s;
  }
  .filter-tab:hover {
    border-color: var(--primary);
    color: var(--primary);
  }
  .filter-tab.is-active {
    background: var(--primary);
    border-color: var(--primary);
    color: var(--primary-foreground);
  }
  .project-item.is-hidden {
    display: none;
  }

  /* Fallback / no-JS: responsive grid (functional, source-ordered). */
  #projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
    gap: 1.25rem;
  }

  /* Native masonry where supported (Safari 26+, Firefox flag). JS bails here. */
  @supports (grid-template-rows: masonry) {
    #projects-grid {
      grid-template-rows: masonry;
    }
  }

  /* JS-driven order-preserving masonry (everywhere else). */
  #projects-grid.is-js-masonry {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
  }
  #projects-grid.is-js-masonry :global(.masonry-col) {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
</style>

<script>
  const GAP = 20;

  function setupProjectsFilter() {
    const grid = document.getElementById("projects-grid");
    const tabs = document.querySelectorAll<HTMLButtonElement>(".filter-tab");
    const countEl = document.getElementById("projects-count");
    if (!grid) return;

    const total = parseInt(countEl?.dataset.total || "0", 10);
    const featured = parseInt(countEl?.dataset.featured || "0", 10);

    // Capture source order once; reused for every relayout so packing stays stable.
    const items = Array.from(grid.children).filter(
      (el): el is HTMLElement =>
        el instanceof HTMLElement && el.classList.contains("project-item"),
    );

    const nativeMasonry = CSS.supports("grid-template-rows", "masonry");

    function colCount() {
      const w = grid!.clientWidth;
      if (w < 640) return 1;
      if (w < 1024) return 2;
      return 3;
    }

    // Greedy shortest-column placement in source order: first N items seed each
    // column (left-to-right), so badges 01,02,03… read across the top row.
    function relayout() {
      if (nativeMasonry) return;
      const cols = colCount();
      const columns: HTMLDivElement[] = [];
      const heights: number[] = [];
      for (let i = 0; i < cols; i++) {
        const c = document.createElement("div");
        c.className = "masonry-col";
        columns.push(c);
        heights.push(0);
      }
      grid!.replaceChildren(...columns);
      for (const item of items) {
        if (item.classList.contains("is-hidden")) continue;
        let idx = 0;
        for (let i = 1; i < cols; i++) {
          if (heights[i] < heights[idx]) idx = i;
        }
        columns[idx].appendChild(item);
        heights[idx] += item.offsetHeight + GAP;
      }
    }

    let currentCols = -1;
    function maybeRelayout() {
      if (nativeMasonry) return;
      const c = colCount();
      if (c !== currentCols) {
        currentCols = c;
        relayout();
      }
    }

    function apply(filter: string) {
      items.forEach((item) => {
        const isFeatured = item.dataset.featured === "true";
        const visible = filter === "all" || isFeatured;
        item.classList.toggle("is-hidden", !visible);
      });
      if (countEl) {
        countEl.textContent = String(filter === "featured" ? featured : total);
      }
      relayout();
    }

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        tabs.forEach((t) => t.classList.remove("is-active"));
        tab.classList.add("is-active");
        apply(tab.dataset.filter || "all");
      });
    });

    if (!nativeMasonry) {
      grid.classList.add("is-js-masonry");
      // Width-driven: only re-pack when the column count actually changes,
      // so our own height mutations never trigger a feedback loop.
      new ResizeObserver(() => maybeRelayout()).observe(grid);
      maybeRelayout();
    }
  }

  document.addEventListener("astro:page-load", setupProjectsFilter);
</script>
