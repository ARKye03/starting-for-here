---
import Layout from "../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

// Detect language from URL, fallback to 'en' if not found
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Helper function to generate language-aware URLs
const getUrl = (path: string) => `/${lang}${path}`;
---

<Layout title={t("404.title")} lang={lang}>
  <div
    class="flex min-h-[80vh] flex-col items-center justify-center px-4 text-center"
  >
    <div class="flex max-w-md flex-col gap-8">
      <div class="text-primary text-8xl font-black opacity-20">404</div>

      <div class="flex flex-col gap-4">
        <h1
          class="text-foreground text-4xl leading-tight font-black tracking-[-0.033em]"
        >
          {t("404.title")}
        </h1>
        <p class="text-muted-foreground text-lg leading-relaxed">
          {t("404.message")}
        </p>
      </div>

      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href={getUrl("/")}
          class="btn btn-primary btn-lg max-w-[240px] min-w-[84px]"
        >
          <span class="truncate">{t("404.backHome")}</span>
        </a>
        <a
          href={getUrl("/about")}
          class="btn btn-secondary btn-lg max-w-[240px] min-w-[84px]"
        >
          <span class="truncate">{t("404.learnAbout")}</span>
        </a>
      </div>

      <div class="border-t pt-8">
        <p class="text-muted-foreground mb-4 text-sm">
          {t("404.lookingFor")}
        </p>
        <div class="flex flex-wrap justify-center gap-4 text-sm">
          <a
            href={getUrl("/projects")}
            class="text-muted-foreground hover:text-primary transition-colors"
          >
            {t("nav.projects")}
          </a>
          <a
            href={getUrl("/about")}
            class="text-muted-foreground hover:text-primary transition-colors"
          >
            {t("nav.about")}
          </a>
          <a
            href={getUrl("/get-in-touch")}
            class="text-muted-foreground hover:text-primary transition-colors"
          >
            {t("nav.contact")}
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
