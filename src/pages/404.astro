---
import Layout from "../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { buttonVariants } from "@assets/components/ui/button";
import { cn } from "@assets/lib/utils";

// Detect language from URL, fallback to 'en' if not found
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Helper function to generate language-aware URLs
const getUrl = (path: string) => `/${lang}${path}`;
---

<Layout title={t("404.title")} lang={lang}>
  <div
    class="flex flex-col items-center justify-center min-h-[80vh] text-center px-4"
  >
    <div class="flex flex-col gap-8 max-w-md">
      <div class="text-8xl font-black text-primary opacity-20">404</div>

      <div class="flex flex-col gap-4">
        <h1
          class="text-4xl font-black leading-tight tracking-[-0.033em] text-foreground"
        >
          {t("404.title")}
        </h1>
        <p class="text-lg text-muted-foreground leading-relaxed">
          {t("404.message")}
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={getUrl("/")}
          class={cn(buttonVariants({ variant: "default", size: "lg" }), "min-w-[84px] max-w-[240px]")}
        >
          <span class="truncate">{t("404.backHome")}</span>
        </a>
        <a
          href={getUrl("/about")}
          class={cn(buttonVariants({ variant: "secondary", size: "lg" }), "min-w-[84px] max-w-[240px]")}
        >
          <span class="truncate">{t("404.learnAbout")}</span>
        </a>
      </div>

      <div class="pt-8 border-t">
        <p class="text-sm text-muted-foreground mb-4">
          {t("404.lookingFor")}
        </p>
        <div class="flex flex-wrap justify-center gap-4 text-sm">
          <a
            href={getUrl("/projects")}
            class="text-muted-foreground hover:text-primary transition-colors"
          >
            {t("nav.projects")}
          </a>
          <a
            href={getUrl("/about")}
            class="text-muted-foreground hover:text-primary transition-colors"
          >
            {t("nav.about")}
          </a>
          <a
            href={getUrl("/get-in-touch")}
            class="text-muted-foreground hover:text-primary transition-colors"
          >
            {t("nav.contact")}
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
