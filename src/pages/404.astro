---
import Layout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const getUrl = (path: string) => `/${lang}${path}`;

// Page prerenders once at /404 (always "en"); client script swaps to ES when needed
const tEs = useTranslations("es");
const esStrings = {
  "404.terminal": tEs("404.terminal"),
  "404.title": tEs("404.title"),
  "404.message": tEs("404.message"),
  "404.backHome": tEs("404.backHome"),
  "404.learnAbout": tEs("404.learnAbout"),
  "404.lookingFor": tEs("404.lookingFor"),
  "nav.projects": tEs("nav.projects"),
  "nav.contact": tEs("nav.contact"),
};
---

<Layout title={t("404.title")} lang={lang}>
  <section
    class="relative flex min-h-[calc(100vh-4rem-5rem)] items-center justify-center overflow-hidden px-6 py-20"
  >
    <div class="grid-bg"></div>
    <div
      class="glow-blob"
      style="top: 30%; left: 50%; transform: translateX(-50%); width: 400px; height: 400px"
    >
    </div>

    <div class="relative z-10 max-w-[600px] text-center">
      <div
        class="mb-8 leading-none font-bold"
        style="font-family: var(--font-display); font-size: clamp(6rem, 20vw, 12.5rem); letter-spacing: -0.04em; color: var(--foreground); user-select: none"
      >
        404
      </div>

      <div
        class="mb-6 font-mono text-[13px]"
        style="color: var(--primary); letter-spacing: 0.02em"
        data-i18n="404.terminal"
      >
        {t("404.terminal")}
      </div>

      <h1
        class="display-h2 mb-3"
        style="font-size: clamp(1.25rem, 3vw, 1.75rem); font-weight: 700"
        data-i18n="404.title"
      >
        {t("404.title")}
      </h1>
      <p
        class="mb-10 text-[15px] leading-[1.6]"
        style="color: var(--muted-foreground); font-family: var(--font-body)"
        data-i18n="404.message"
      >
        {t("404.message")}
      </p>

      <div class="mb-12 flex flex-wrap justify-center gap-3">
        <a
          href={getUrl("/")}
          class="btn btn-primary btn-mono inline-flex items-center"
          data-i18n="404.backHome"
        >
          {t("404.backHome")}
        </a>
        <a
          href={getUrl("/about")}
          class="btn btn-outline btn-mono inline-flex items-center"
          data-i18n="404.learnAbout"
        >
          {t("404.learnAbout")}
        </a>
      </div>

      <div>
        <div
          class="mb-4 font-mono text-[11px] tracking-[0.1em] uppercase"
          style="color: var(--muted-foreground); opacity: 0.6"
          data-i18n="404.lookingFor"
        >
          {t("404.lookingFor")}
        </div>
        <div class="flex flex-wrap justify-center gap-4">
          <a href={getUrl("/projects")} class="quick-link">
            <Icon name="arrow-right" class="h-3 w-3" />
            <span data-i18n="nav.projects">{t("nav.projects")}</span>
          </a>
          <a href={getUrl("/get-in-touch")} class="quick-link">
            <Icon name="arrow-right" class="h-3 w-3" />
            <span data-i18n="nav.contact">{t("nav.contact")}</span>
          </a>
          <a
            href="https://github.com/ARKye03"
            target="_blank"
            rel="noopener noreferrer"
            class="quick-link"
          >
            <Icon name="arrow-up-right" class="h-3 w-3" />
            GitHub
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ esStrings }}>
  const wantsEs =
    location.pathname.startsWith("/es") ||
    /(?:^|;\s*)lang=es(?:;|$)/.test(document.cookie);
  if (wantsEs) {
    document.documentElement.lang = "es";
    document.title = esStrings["404.title"];
    for (const el of document.querySelectorAll("[data-i18n]")) {
      const value = esStrings[el.dataset.i18n];
      if (value) el.textContent = value;
    }
    for (const a of document.querySelectorAll('a[href^="/en/"]')) {
      a.setAttribute("href", a.getAttribute("href").replace(/^\/en/, "/es"));
    }
  }
</script>

<style>
  .quick-link {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--muted-foreground);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: color 0.2s;
  }
  .quick-link:hover {
    color: var(--primary);
  }
</style>
