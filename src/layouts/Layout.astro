---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";

import type { Language } from "../i18n/utils";

export interface Props {
  title?: string;
  currentPage?: "home" | "about" | "projects" | "contact";
  lang?: Language;
}

const { title = "Portfolio", currentPage = "home", lang = "en" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class={"min-h-screen dark:bg-background dark:text-white"}>
    <main class="max-w-[960px] mx-auto px-4 md:px-10 py-5">
      <Header currentPage={currentPage} lang={lang} />
      <div>
        <slot />
      </div>
      <Footer />
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
