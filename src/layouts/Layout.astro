---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
	title?: string;
	currentPage?: "home" | "about" | "projects" | "contact";
}

const { title = "Portfolio", currentPage = "home" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class={"min-h-screen bg-background text-white"}>
		<div
			class="relative flex h-auto min-h-screen w-full flex-col overflow-x-hidden"
		>
			<div class="layout-container flex h-full grow flex-col">
				<div class="flex flex-1 justify-center py-5">
					<div
						class="layout-content-container flex flex-col max-w-[960px] flex-1"
					>
						<Header currentPage={currentPage} />
						<slot />
						<Footer />
					</div>
				</div>
			</div>
		</div>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
