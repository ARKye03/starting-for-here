---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface Props {
	title?: string;
	currentPage?: "home" | "about" | "projects" | "contact";
	variant?: "default" | "dark";
}

const {
	title = "Portfolio",
	currentPage = "home",
	variant = "default",
} = Astro.props;

const isDark = variant === "dark";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body
		class={`min-h-screen ${isDark ? "bg-background-dark text-white" : "bg-background-light dark:bg-background-dark text-gray-900 dark:text-white"}`}
	>
		{
			isDark ? (
				<div class="relative flex h-auto min-h-screen w-full flex-col overflow-x-hidden">
					<div class="layout-container flex h-full grow flex-col">
						<div class="flex flex-1 justify-center py-5">
							<div class="layout-content-container flex flex-col max-w-[960px] flex-1">
								<Header currentPage={currentPage} />
								<slot />
								<Footer />
							</div>
						</div>
					</div>
				</div>
			) : (
				<div class="px-4 md:px-10 lg:px-40 flex justify-center py-5">
					<div class="flex flex-col max-w-[960px] flex-1">
						<Header currentPage={currentPage} />
						<slot />
						<Footer />
					</div>
				</div>
			)
		}
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
