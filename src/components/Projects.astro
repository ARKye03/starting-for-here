---
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";

// Define pinned projects in desired order
const pinnedProjectSlugs = ["larasdelitesse", "morghulis", "portfolio"];

const allProjects = await getCollection("projects");
const projects = pinnedProjectSlugs
  .map((slug) => allProjects.find((project) => project.slug === slug))
  .filter((project) => project !== undefined);
---

<section>
  <h2
    class="text-[22px] font-bold leading-tight tracking-[-0.015em] px-4 pb-3 pt-5"
  >
    My Best Projects
  </h2>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(250px,1fr))] gap-4 p-4">
    {
      projects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          slug={project.slug}
          tags={project.data.tags}
          image={project.data.images?.[0]}
        />
      ))
    }
  </div>
</section>
