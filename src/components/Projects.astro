---
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Define pinned projects in desired order (without lang prefix)
const pinnedProjectSlugs = ["larasdelitesse", "morghulis", "portfolio"];

const allProjects = await getCollection("projects");
const projects = pinnedProjectSlugs
  .map((slug) =>
    allProjects.find((project) => {
      // ID might be "en/slug.md", we want to compare against "en/slug"
      const idWithoutExt = project.id.replace(/\.[^/.]+$/, "");
      return idWithoutExt === `${lang}/${slug}`;
    }),
  )
  .filter((project) => project !== undefined)
  .map((project) => ({
    ...project,
    slug: project.id
      .split("/")
      .slice(1)
      .join("/")
      .replace(/\.[^/.]+$/, ""),
  }));
---

<section>
  <h2
    class="text-foreground text-[22px] font-bold leading-tight tracking-[-0.015em] px-4 pb-3 pt-5"
  >
    {t("projects.bestProjects")}
  </h2>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(250px,1fr))] gap-4 p-4">
    {
      projects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          slug={project.slug}
          tags={project.data.tags}
          image={project.data.images?.[0]}
        />
      ))
    }
  </div>
</section>
