---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import ProjectCard from "./ProjectCard.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pinnedProjectSlugs = ["wawkoss", "morghulis", "ferox"];

const allProjects = await getCollection("projects");
const projects = pinnedProjectSlugs
  .map((slug) =>
    allProjects.find((project) => {
      const idWithoutExt = project.id.replace(/\.[^/.]+$/, "");
      return idWithoutExt === `${lang}/${slug}`;
    }),
  )
  .filter((project) => project !== undefined)
  .map((project) => ({
    ...project,
    slug: project.id
      .split("/")
      .slice(1)
      .join("/")
      .replace(/\.[^/.]+$/, ""),
  }));
---

<section class="px-6 py-24 md:py-28">
  <div class="mx-auto max-w-[1120px]">
    <div class="mb-12 flex flex-wrap items-end justify-between gap-4">
      <div>
        <div class="section-label mb-3">{t("projects.portfolioLabel")}</div>
        <h2 class="display-h2">{t("projects.bestProjects")}</h2>
      </div>
      <a
        href={`/${lang}/projects`}
        class="nav-link inline-flex items-center gap-1.5 tracking-normal normal-case"
        style="text-transform: none"
      >
        {t("projects.viewAll")}
        <Icon name="arrow-right" class="h-3.5 w-3.5" />
      </a>
    </div>

    <div
      class="grid gap-5"
      style="grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr))"
    >
      {
        projects.map((project, i) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            slug={project.slug}
            tags={project.data.tags}
            date={project.data.date}
            featured={project.data.featured}
            index={i}
          />
        ))
      }
    </div>
  </div>
</section>
