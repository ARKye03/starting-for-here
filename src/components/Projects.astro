---
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";

// Get all projects and sort by date (newest first)
const allProjects = await getCollection("projects");
const projects = allProjects
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .slice(0, 3); // Show only 3 most recent
---

<section>
    <h2
        class="text-[22px] font-bold leading-tight tracking-[-0.015em] px-4 pb-3 pt-5"
    >
        My Best Projects
    </h2>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(250px,1fr))] gap-4 p-4">
        {
            projects.map((project) => (
                <ProjectCard
                    title={project.data.title}
                    description={project.data.description}
                    slug={project.slug}
                    tags={project.data.tags}
                />
            ))
        }
    </div>
    <div class="flex px-4 py-8 justify-center">
        <a
            href="/projects"
            class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-12 px-5 bg-primary text-white text-base font-bold leading-normal tracking-[0.015em] hover:bg-primary/90 transition-colors"
        >
            <span class="truncate">View All Projects</span>
        </a>
    </div>
</section>
