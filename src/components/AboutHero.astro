---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="relative overflow-hidden px-6 pt-24 pb-12 md:pt-32">
  <div class="grid-bg"></div>
  <div class="relative z-10 mx-auto max-w-[1120px]">
    <div class="section-label mb-4">{t("section.about")}</div>
    <h1 class="display-h2 max-w-[720px]">{t("about.hero.title")}</h1>
  </div>
</section>
