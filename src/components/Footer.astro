---
import { Icon } from "astro-icon/components";
---

<footer class="text-muted-foreground mt-10 border-t px-4 py-6 text-center">
  <div class="mb-4 flex justify-center gap-4">
    <a
      class="hover:text-primary transition-colors"
      href="https://github.com/ARKye03"
      aria-label="GitHub"
    >
      <Icon name="github" aria-hidden="true" class="h-6 w-6" />
    </a>
    <a
      class="hover:text-primary transition-colors"
      href="https://www.linkedin.com/in/rafa03-dev"
      aria-label="LinkedIn"
    >
      <Icon name="linkedin" aria-hidden="true" class="h-6 w-6" />
    </a>
    <a
      class="hover:text-primary transition-colors"
      href="https://x.com/RafaelzSanchez"
      aria-label="Twitter"
    >
      <Icon name="twitter" aria-hidden="true" class="h-6 w-6" />
    </a>
  </div>
</footer>
