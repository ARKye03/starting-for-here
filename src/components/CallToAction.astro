---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="px-6 py-20">
  <div
    class="relative mx-auto max-w-[800px] overflow-hidden rounded-[var(--radius)] border px-10 py-16 text-center"
    style="background: var(--card); border-color: var(--border)"
  >
    <span
      class="absolute top-0 right-[20%] left-[20%] h-px"
      style="background: linear-gradient(90deg, transparent, var(--primary), transparent)"
      aria-hidden="true"></span>
    <h2
      class="display-h2 mb-3"
      style="font-size: clamp(1.5rem, 3.5vw, 2.25rem)"
    >
      {t("cta.title")}
    </h2>
    <p
      class="mx-auto mb-8 max-w-xl text-[15px] leading-[1.6]"
      style="color: var(--muted-foreground); font-family: var(--font-body)"
    >
      {t("cta.subtitle")}
    </p>
    <a
      href={`/${lang}/get-in-touch`}
      class="btn btn-primary btn-mono inline-flex items-center gap-2"
    >
      {t("nav.contact")}
      <Icon name="arrow-right" class="h-4 w-4" />
    </a>
  </div>
</section>
