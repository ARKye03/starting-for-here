---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="flex flex-col items-center gap-4 px-4 py-16 text-center">
  <h3 class="text-foreground text-3xl font-bold">
    {t("cta.title")}
  </h3>
  <p class="text-muted-foreground max-w-xl text-lg">
    {t("cta.subtitle")}
  </p>
  <a
    class="btn btn-primary btn-lg mt-4 max-w-[240px] min-w-[84px]"
    href={`/${lang}/get-in-touch`}
  >
    <span class="truncate">{t("nav.contact")}</span>
  </a>
</section>
