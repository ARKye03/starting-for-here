---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const entries = [
  {
    year: t("about.journey.present"),
    label: t("about.journey.freelance"),
    desc:
      lang === "es"
        ? "Desarrollador freelance, creando soluciones web a medida."
        : "Freelance developer, crafting bespoke web solutions.",
  },
  {
    year: "2022",
    label: t("about.journey.career"),
    desc:
      lang === "es"
        ? "Inicio de carrera en Ciencias de la Computación."
        : "Started Computer Science career.",
  },
  {
    year: "2019",
    label: t("about.journey.early"),
    desc: t("about.journey.early"),
  },
];
---

<div>
  <h3 class="display-h3 mb-6">{t("about.journey.title")}</h3>
  <ol class="relative flex flex-col gap-7" style="margin-left: 0">
    <span
      class="absolute left-[5px] top-2 bottom-2 w-px"
      style="background: var(--border)"
      aria-hidden="true"></span>
    {
      entries.map((entry, i) => (
        <li class="relative flex gap-5">
          <span
            class="mt-1 h-[11px] w-[11px] shrink-0 rounded-full border-2"
            style={
              i === 0
                ? "background: var(--primary); border-color: var(--primary)"
                : "background: var(--border); border-color: var(--muted-foreground)"
            }
          />
          <div>
            <div
              class="mb-1 font-mono text-xs tracking-[0.05em]"
              style="color: var(--primary)"
            >
              {entry.year} — {entry.label}
            </div>
            <div
              class="text-[14px] leading-[1.5]"
              style="color: var(--muted-foreground); font-family: var(--font-body)"
            >
              {entry.desc}
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</div>
