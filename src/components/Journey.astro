---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section>
  <h2 class="text-foreground text-3xl font-bold leading-tight px-4 pb-3 pt-10">
    {t("about.journey.title")}
  </h2>
  <div class="grid grid-cols-[auto_1fr] gap-x-4 px-4 py-8">
    <div class="flex flex-col items-center gap-1.5 pt-1">
      <span class="text-primary text-3xl">💼</span>
      <div class="w-px bg-border h-full"></div>
    </div>
    <div class="flex flex-1 flex-col pb-10">
      <p class="text-foreground text-lg font-medium leading-normal">
        {t("about.journey.freelance")}
      </p>
      <p class="text-muted-foreground text-base font-normal leading-normal">
        2024 - {t("about.journey.present")}
      </p>
    </div>
    <div class="flex flex-col items-center gap-1.5 pt-1">
      <div class="w-px bg-border h-2"></div>
      <span class="text-primary text-3xl">💼</span>
      <div class="w-px bg-border h-full"></div>
    </div>
    <div class="flex flex-1 flex-col pb-10">
      <p class="text-foreground text-lg font-medium leading-normal">
        {t("about.journey.career")}
      </p>
      <p class="text-muted-foreground text-base font-normal leading-normal">
        2022 - 2024
      </p>
    </div>
    <div class="flex flex-col items-center gap-1.5 pt-1">
      <div class="w-px bg-border h-2"></div>
      <span class="text-primary text-3xl">🎓</span>
    </div>
    <div class="flex flex-1 flex-col">
      <p class="text-foreground text-lg font-medium leading-normal">
        {t("about.journey.early")}
      </p>
      <p class="text-muted-foreground text-base font-normal leading-normal">
        2018 - 2022
      </p>
    </div>
  </div>
</section>
