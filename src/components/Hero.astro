---

---

<section class="@container">
    <div
        class="flex flex-col-reverse gap-6 px-4 py-10 @[480px]:gap-8 @[864px]:flex-row items-center"
    >
        <div
            class="flex flex-col gap-6 @[480px]:min-w-[400px] @[480px]:gap-8 @[864px]:justify-center text-center @[864px]:text-left"
        >
            <div class="flex flex-col gap-2">
                <h1
                    class="text-4xl font-black leading-tight tracking-[-0.033em] @[480px]:text-5xl"
                >
                    Creative Software Developer
                </h1>
                <h2
                    class="text-sm font-normal leading-normal @[480px]:text-base text-gray-600 dark:text-gray-300"
                >
                    I design and code beautifully simple things, and I love what
                    I do. I'm a passionate developer with a knack for creating
                    elegant and effective solutions.
                </h2>
            </div>
            <div
                class="flex flex-col @[480px]:flex-row gap-4 justify-center @[864px]:justify-start"
            >
                <button
                    class="flex min-w-[84px] w-full @[480px]:w-auto max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-12 px-5 bg-primary text-white text-base font-bold leading-normal tracking-[0.015em] hover:bg-primary-90 transition-colors"
                >
                    <span class="truncate">View All Projects</span>
                </button>
                <button
                    class="flex min-w-[84px] w-full @[480px]:w-auto max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-12 px-5 bg-primary-20 text-primary text-base font-bold leading-normal tracking-[0.015em] hover:bg-primary-30 transition-colors"
                >
                    <span class="truncate">About Me</span>
                </button>
            </div>
        </div>
        <div
            class="w-full max-w-[300px] @[864px]:max-w-full bg-center bg-no-repeat aspect-square bg-cover rounded-full @[480px]:h-auto @[480px]:min-w-[300px] @[864px]:w-full bg-gray-300 dark:bg-gray-700"
        >
            <img
                src="/arkye03.webp"
                alt="Profile Picture"
                class="w-full h-full object-cover rounded-full"
            />
        </div>
    </div>
</section>
