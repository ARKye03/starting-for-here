---
import { Image } from "astro:assets";
import myProfilePic from "@assets/profile.webp";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { buttonVariants } from "@assets/components/ui/button";
import { cn } from "@assets/lib/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="@container">
  <div
    class="flex flex-col-reverse gap-6 px-4 py-8 @[480px]:gap-8 @[864px]:flex-row items-center"
  >
    <div
      class="flex flex-col gap-6 @[480px]:min-w-[400px] @[480px]:gap-8 @[864px]:justify-center text-center @[864px]:text-left"
    >
      <div class="flex flex-col gap-2">
        <h1
          class="text-4xl font-black leading-tight tracking-[-0.033em] @[480px]:text-5xl"
        >
          {t("hero.title")}
        </h1>
        <h2
          class="text-sm font-normal leading-normal @[480px]:text-base text-muted-foreground"
        >
          {t("hero.subtitle")}
        </h2>
      </div>
      <div
        class="flex flex-col @[480px]:flex-row gap-4 justify-center @[864px]:justify-start"
      >
        <a
          href={`/${lang}/projects`}
          class={cn(buttonVariants({ variant: "default", size: "lg" }), "min-w-[84px] w-full @[480px]:w-auto")}
        >
          <span class="truncate">{t("hero.viewProjects")}</span>
        </a>
        <a
          href={`/${lang}/about`}
          class={cn(buttonVariants({ variant: "secondary", size: "lg" }), "min-w-[84px] w-full @[480px]:w-auto")}
        >
          <span class="truncate">{t("hero.aboutMe")}</span>
        </a>
      </div>
    </div>
    <div
      class="w-full max-w-[300px] @[864px]:max-w-full bg-center bg-no-repeat aspect-square bg-cover rounded-full @[480px]:h-auto @[480px]:min-w-[300px] @[864px]:w-full bg-muted"
    >
      <Image
        src={myProfilePic}
        alt="Profile"
        class="w-full h-full object-cover rounded-full"
        loading="eager"
        transition:name="myProfilePic"
      />
    </div>
  </div>
</section>
