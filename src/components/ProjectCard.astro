---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export interface Props {
  title: string;
  description: string;
  slug?: string;
  tags?: string[];
  image?: string;
}

const { title, slug, tags, image } = Astro.props;
const projectUrl = slug ? `/${lang}/projects/${slug}` : "#";
const backgroundImage = image ? `/projects/${image}` : "";
const transitionName = `project-${slug}`;
---

<a
  href={projectUrl}
  class="group project-card relative flex aspect-video flex-col justify-end gap-3 overflow-hidden rounded-lg bg-gradient-to-t from-black/60 to-transparent bg-cover bg-center p-4 no-underline"
  style={backgroundImage
    ? `background-image: linear-gradient(to top, rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.3)), url('${backgroundImage}'); view-transition-name: ${transitionName};`
    : ""}
  transition:name={transitionName}
>
  <p
    class="relative z-10 line-clamp-2 text-base leading-tight font-bold text-white dark:text-white"
  >
    {title}
  </p>
  {
    tags && tags.length > 0 && (
      <div class="relative z-10 flex flex-wrap gap-2">
        {tags.slice(0, 2).map((tag) => (
          <span class="bg-primary/20 rounded border border-white/20 px-2 py-1 text-xs text-white backdrop-blur-sm dark:text-white">
            {tag}
          </span>
        ))}
      </div>
    )
  }
  <div
    class="absolute inset-0 flex items-center justify-center bg-black/60 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
  >
    <span class="text-lg font-bold text-white dark:text-white"
      >{t("common.viewProject")}</span
    >
  </div>
</a>
