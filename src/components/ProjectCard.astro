---
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export interface Props {
  title: string;
  description: string;
  slug?: string;
  tags?: string[];
  image?: string;
}

const { title, slug, tags, image } = Astro.props;
const projectUrl = slug ? `/${lang}/projects/${slug}` : "#";
const transitionName = `project-${slug}`;
---

<a
  href={projectUrl}
  class="group bg-base-200 relative flex aspect-video flex-col justify-end gap-3 overflow-hidden rounded-lg p-4 no-underline"
  transition:name={transitionName}
>
  {
    image && (
      <Image
        src={`/projects/${image}`}
        alt={title}
        class="absolute inset-0 h-full w-full object-cover"
        width={600}
        height={338}
      />
    )
  }
  <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-black/30">
  </div>
  <p
    class="relative z-10 line-clamp-2 text-base leading-tight font-bold text-white"
  >
    {title}
  </p>
  {
    tags && tags.length > 0 && (
      <div class="relative z-10 flex flex-wrap gap-2">
        {tags.slice(0, 2).map((tag) => (
          <span class="bg-primary/20 rounded border border-white/20 px-2 py-1 text-xs text-white backdrop-blur-sm">
            {tag}
          </span>
        ))}
      </div>
    )
  }
  <div
    class="absolute inset-0 flex items-center justify-center bg-black/60 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
  >
    <span class="text-lg font-bold text-white">{t("common.viewProject")}</span>
  </div>
</a>
