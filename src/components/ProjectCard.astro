---
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export interface Props {
  title: string;
  description: string;
  slug?: string;
  tags?: string[];
  date?: Date;
  featured?: boolean;
  index?: number;
  image?: string;
}

const {
  title,
  description,
  slug,
  tags = [],
  date,
  featured = false,
  index = 0,
} = Astro.props;
const projectUrl = slug ? `/${lang}/projects/${slug}` : "#";
const transitionName = `project-${slug}`;
const num = String(index + 1).padStart(2, "0");
const dateStr = date
  ? date.toLocaleDateString(lang === "es" ? "es-ES" : "en-US", {
      year: "numeric",
      month: "short",
      timeZone: "UTC",
    })
  : "";
---

<a
  href={projectUrl}
  class="card-elevated project-card group block p-7 no-underline"
  transition:name={transitionName}
  aria-label={title}
>
  {
    featured && (
      <div
        class="absolute top-3 right-3 z-2 rounded-(--radius) border px-2 py-[2px] font-mono text-[10px] tracking-[0.08em] uppercase"
        style="color: var(--primary); border-color: var(--primary); opacity: 0.7"
      >
        {t("projects.filter.featured")}
      </div>
    )
  }

  <div class="card-index mb-4 font-mono text-[11px] tracking-widest">
    {num}
  </div>

  <h3 class="display-h3 mb-2" style="font-size: 1.375rem">{title}</h3>

  {
    dateStr && (
      <div
        class="mb-3 font-mono text-[11px]"
        style="color: var(--muted-foreground); opacity: 0.5"
      >
        {dateStr}
      </div>
    )
  }

  <p
    class="mb-5 text-[14px] leading-[1.65]"
    style="color: var(--muted-foreground); font-family: var(--font-body)"
  >
    {description}
  </p>

  {
    tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {tags.slice(0, 5).map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )
  }

  <div
    class="absolute right-6 bottom-6 translate-x-2 translate-y-2 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:translate-y-0 group-hover:opacity-100"
    style="color: var(--primary)"
  >
    <Icon name="arrow-up-right" class="h-5 w-5" />
  </div>
</a>

<style>
  /* Mauve "selected row" indicator that wipes down the left edge on hover. */
  .project-card::after {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--primary) 28%,
      var(--primary) 72%,
      transparent
    );
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 2;
    pointer-events: none;
  }
  .project-card:hover::after {
    transform: scaleY(1);
  }
  .project-card:hover {
    border-color: color-mix(in oklab, var(--primary) 45%, var(--border));
  }

  /* The index number is the signature — ignite it on hover. */
  .card-index {
    display: inline-block;
    color: var(--muted-foreground);
    opacity: 0.5;
    transform-origin: left center;
    transition:
      color 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .project-card:hover .card-index {
    color: var(--primary);
    opacity: 1;
    transform: scale(1.35) translateX(1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card::after,
    .card-index {
      transition: none;
    }
    .project-card:hover .card-index {
      transform: none;
    }
  }
</style>
