---
import Logo from "@assets/logo.svg";
import {
  useTranslations,
  getAlternateLangUrl,
  type Language,
} from "../i18n/utils";
import { languages } from "../i18n/ui";
import { buttonVariants } from "@assets/components/ui/button";
import { cn } from "@assets/lib/utils";
import { Languages } from "lucide-react";

export interface Props {
  currentPage?: "home" | "about" | "projects" | "contact";
  lang?: Language;
}

const { currentPage = "home", lang = "en" } = Astro.props;
const t = useTranslations(lang);

// Helper function to generate language-aware URLs
const getUrl = (path: string) => `/${lang}${path}`;

// Get alternate language (switch between en/es)
const alternateLang = lang === "en" ? "es" : "en";
const alternateLangUrl = getAlternateLangUrl(Astro.url, alternateLang);
---

<header
  class="bg-background/80 sticky top-0 z-50 flex items-center justify-between border-b px-4 py-3 whitespace-nowrap backdrop-blur-md md:px-10"
>
  <a href={getUrl("/")} class="group flex items-center gap-4">
    <div class="text-primary size-6">
      <!-- I don't like this bottom/right thing, but hey, looks fine on mobile and web so 11/10 -->
      <Logo class="relative right-3 bottom-2 h-10 w-10" />
    </div>
    <div class="relative overflow-hidden">
      <h2
        class="text-lg leading-tight font-bold tracking-[-0.015em] transition-transform duration-300 group-hover:-translate-y-full"
      >
        Rafael Sanchez Martinez
      </h2>
      <span
        class="text-primary absolute top-0 left-0 translate-y-full transform text-lg leading-tight font-bold tracking-[-0.015em] transition-transform duration-300 group-hover:translate-y-0"
      >
        aka ARKye03
      </span>
    </div>
  </a>
  <div class="hidden flex-1 justify-end gap-8 md:flex">
    <div class="flex items-center gap-9">
      <a
        class={`text-sm font-medium leading-normal transition-colors ${
          currentPage === "home" ? "text-primary" : "hover:text-primary"
        }`}
        href={getUrl("/")}
      >
        {t("nav.home")}
      </a>
      <a
        class={`text-sm font-medium leading-normal transition-colors ${
          currentPage === "about" ? "text-primary" : "hover:text-primary"
        }`}
        href={getUrl("/about")}
      >
        {t("nav.about")}
      </a>
      <a
        class={`text-sm font-medium leading-normal transition-colors ${
          currentPage === "projects" ? "text-primary" : "hover:text-primary"
        }`}
        href={getUrl("/projects")}
      >
        {t("nav.projects")}
      </a>
    </div>
    <a
      class={cn(buttonVariants({ variant: "default" }), "min-w-[84px]")}
      href={getUrl("/get-in-touch")}
    >
      <span class="truncate">{t("nav.contact")}</span>
    </a>
    <!-- Language Switcher -->
    <div class="ml-2 flex items-center border-l pl-6">
      <a
        href={alternateLangUrl}
        class="text-muted-foreground hover:text-primary text-sm font-bold tracking-widest uppercase transition-colors"
        title={`Switch to ${languages[alternateLang]}`}
      >
        {alternateLang}
      </a>
    </div>
  </div>
  <details class="group relative md:hidden">
    <summary class="cursor-pointer list-none p-2" aria-label="Toggle menu">
      <span class="text-xl group-open:hidden">☰</span>
      <span class="hidden text-xl group-open:inline">✕</span>
    </summary>

    <nav
      class="bg-popover absolute top-full right-0 z-50 mt-2 w-48 rounded-lg border shadow-lg"
    >
      <div class="flex flex-col py-2">
        <a
          class={cn(
            "px-4 py-3 text-sm font-medium hover:bg-accent transition-colors rounded-md",
            currentPage === "home" && "text-primary",
          )}
          href={getUrl("/")}
        >
          {t("nav.home")}
        </a>
        <a
          class={cn(
            "px-4 py-3 text-sm font-medium hover:bg-accent transition-colors rounded-md",
            currentPage === "about" && "text-primary",
          )}
          href={getUrl("/about")}
        >
          {t("nav.about")}
        </a>
        <a
          class={cn(
            "px-4 py-3 text-sm font-medium hover:bg-accent transition-colors rounded-md",
            currentPage === "projects" && "text-primary",
          )}
          href={getUrl("/projects")}
        >
          {t("nav.projects")}
        </a>
        <a
          class={cn(buttonVariants({ variant: "default" }), "mx-2 my-2")}
          href={getUrl("/get-in-touch")}
        >
          {t("nav.contact")}
        </a>
        <!-- Language Switcher -->
        <div class="mt-2 border-t px-4 py-3">
          <a
            href={alternateLangUrl}
            class="text-muted-foreground hover:text-primary flex items-center gap-2 text-sm font-medium transition-colors"
          >
            <Languages />
            <span class="uppercase">{languages[alternateLang]}</span>
          </a>
        </div>
      </div>
    </nav>
  </details>
</header>
