---
export interface Props {
    currentPage?: "home" | "about" | "projects" | "contact";
}

const { currentPage = "home" } = Astro.props;
---

<header
    class="flex items-center justify-between whitespace-nowrap border-b border-solid border-gray-200 dark:border-b-[#302938] px-4 md:px-10 py-3"
>
    <a href="/" class="flex items-center gap-4">
        <div class="size-6 text-primary">
            <svg
                fill="currentColor"
                viewBox="0 0 48 48"
                xmlns="http://www.w3.org/2000/svg"
            >
                <g clip-path="url(#clip0_6_319)">
                    <path
                        d="M8.57829 8.57829C5.52816 11.6284 3.451 15.5145 2.60947 19.7452C1.76794 23.9758 2.19984 28.361 3.85056 32.3462C5.50128 36.3314 8.29667 39.7376 11.8832 42.134C15.4698 44.5305 19.6865 45.8096 24 45.8096C28.3135 45.8096 32.5302 44.5305 36.1168 42.134C39.7033 39.7375 42.4987 36.3314 44.1494 32.3462C45.8002 28.361 46.2321 23.9758 45.3905 19.7452C44.549 15.5145 42.4718 11.6284 39.4217 8.57829L24 24L8.57829 8.57829Z"
                    ></path>
                </g>
                <defs>
                    <clipPath id="clip0_6_319">
                        <rect fill="white" height="48" width="48"></rect>
                    </clipPath>
                </defs>
            </svg>
        </div>
        <h2 class="text-lg font-bold leading-tight tracking-[-0.015em]">
            Rafael
        </h2>
    </a>
    <div class="hidden md:flex flex-1 justify-end gap-8">
        <div class="flex items-center gap-9">
            <a
                class={`text-sm font-medium leading-normal transition-colors ${
                    currentPage === "home"
                        ? "text-primary"
                        : "hover:text-primary"
                }`}
                href="/"
            >
                Home
            </a>
            <a
                class={`text-sm font-medium leading-normal transition-colors ${
                    currentPage === "about"
                        ? "text-primary"
                        : "hover:text-primary"
                }`}
                href="/about"
            >
                About
            </a>
            <a
                class={`text-sm font-medium leading-normal transition-colors ${
                    currentPage === "projects"
                        ? "text-primary"
                        : "hover:text-primary"
                }`}
                href="/projects"
            >
                Projects
            </a>
        </div>
        <a
            class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-primary text-white text-sm font-bold leading-normal tracking-[0.015em] hover:bg-primary-90 transition-colors"
            href="/get-in-touch"
        >
            <span class="truncate">Get in Touch</span>
        </a>
    </div>
    <div class="md:hidden relative">
        <button id="mobile-menu-button" class="p-2" aria-label="Toggle menu">
            <span id="menu-icon" class="text-xl">☰</span>
        </button>

        <!-- Mobile Menu Dropdown -->
        <div
            id="mobile-menu"
            class="absolute right-0 top-full mt-2 w-48 bg-background border border-gray-200 dark:border-gray-700 rounded-lg shadow-xl opacity-0 invisible transition-all duration-200 ease-in-out z-50"
        >
            <nav class="flex flex-col py-2">
                <a
                    class={`px-4 py-3 text-sm font-medium hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors ${
                        currentPage === "home" ? "text-primary" : ""
                    }`}
                    href="/"
                >
                    Home
                </a>
                <a
                    class={`px-4 py-3 text-sm font-medium hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors ${
                        currentPage === "about" ? "text-primary" : ""
                    }`}
                    href="/about"
                >
                    About
                </a>
                <a
                    class={`px-4 py-3 text-sm font-medium hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors ${
                        currentPage === "projects" ? "text-primary" : ""
                    }`}
                    href="/projects"
                >
                    Projects
                </a>
                <a
                    class="mx-2 my-2 flex items-center justify-center rounded-lg h-10 px-4 bg-primary text-white text-sm font-bold leading-normal tracking-[0.015em] hover:bg-primary-90 transition-colors"
                    href="/get-in-touch"
                >
                    Get in Touch
                </a>
            </nav>
        </div>
    </div>
</header>

<script>
    document.addEventListener("astro:page-load", () => {
        const button = document.getElementById("mobile-menu-button");
        const menu = document.getElementById("mobile-menu");
        const icon = document.getElementById("menu-icon");

        button?.addEventListener("click", (e) => {
            e.stopPropagation();
            menu?.classList.toggle("opacity-0");
            menu?.classList.toggle("invisible");
            if (icon)
                icon.textContent = menu?.classList.contains("opacity-0")
                    ? "☰"
                    : "✕";
        });

        document.addEventListener("click", () => {
            menu?.classList.add("opacity-0", "invisible");
            if (icon) icon.textContent = "☰";
        });
    });
</script>
