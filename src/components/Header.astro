---
import Logo from "@public/logo.svg";

export interface Props {
  currentPage?: "home" | "about" | "projects" | "contact";
}

const { currentPage = "home" } = Astro.props;
---

<header
  class="flex items-center justify-between whitespace-nowrap border-b border-solid border-gray-200 dark:border-b-[#302938] px-4 md:px-10 py-3"
>
  <a href="/" class="flex items-center gap-4 group">
    <div class="size-6 text-primary">
      <!-- I don't like this bottom/right thing, but hey, looks fine on mobile and web so 11/10 -->
      <Logo class="relative w-10 h-10 bottom-2 right-3" />
    </div>
    <div class="relative overflow-hidden">
      <h2
        class="text-lg font-bold leading-tight tracking-[-0.015em] transition-transform duration-300 group-hover:-translate-y-full"
      >
        Rafael Sanchez Martinez
      </h2>
      <span
        class="absolute top-0 left-0 text-lg font-bold leading-tight tracking-[-0.015em] text-primary transform translate-y-full transition-transform duration-300 group-hover:translate-y-0"
      >
        aka ARKye03
      </span>
    </div>
  </a>
  <div class="hidden md:flex flex-1 justify-end gap-8">
    <div class="flex items-center gap-9">
      <a
        class={`text-sm font-medium leading-normal transition-colors ${
          currentPage === "home" ? "text-primary" : "hover:text-primary"
        }`}
        href="/"
      >
        Home
      </a>
      <a
        class={`text-sm font-medium leading-normal transition-colors ${
          currentPage === "about" ? "text-primary" : "hover:text-primary"
        }`}
        href="/about"
      >
        About
      </a>
      <a
        class={`text-sm font-medium leading-normal transition-colors ${
          currentPage === "projects" ? "text-primary" : "hover:text-primary"
        }`}
        href="/projects"
      >
        Projects
      </a>
    </div>
    <a
      class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 bg-primary text-white text-sm font-bold leading-normal tracking-[0.015em] hover:bg-primary-90 transition-colors"
      href="/get-in-touch"
    >
      <span class="truncate">Get in Touch</span>
    </a>
  </div>
  <details class="md:hidden relative group">
    <summary class="p-2 cursor-pointer list-none" aria-label="Toggle menu">
      <span class="text-xl group-open:hidden">☰</span>
      <span class="text-xl hidden group-open:inline">✕</span>
    </summary>

    <nav
      class="absolute right-0 top-full mt-2 w-48 bg-background border border-gray-200 dark:border-gray-700 rounded-lg shadow-xl z-50"
    >
      <div class="flex flex-col py-2">
        <a
          class={`px-4 py-3 text-sm font-medium hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors ${
            currentPage === "home" ? "text-primary" : ""
          }`}
          href="/"
        >
          Home
        </a>
        <a
          class={`px-4 py-3 text-sm font-medium hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors ${
            currentPage === "about" ? "text-primary" : ""
          }`}
          href="/about"
        >
          About
        </a>
        <a
          class={`px-4 py-3 text-sm font-medium hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors ${
            currentPage === "projects" ? "text-primary" : ""
          }`}
          href="/projects"
        >
          Projects
        </a>
        <a
          class="mx-2 my-2 flex items-center justify-center rounded-lg h-10 px-4 bg-primary text-white text-sm font-bold leading-normal tracking-[0.015em] hover:bg-primary-90 transition-colors"
          href="/get-in-touch"
        >
          Get in Touch
        </a>
      </div>
    </nav>
  </details>
</header>
