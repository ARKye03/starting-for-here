---
import Logo from "@assets/logo.svg";
import {
  useTranslations,
  getAlternateLangUrl,
  type Language,
} from "../i18n/utils";
import { languages } from "../i18n/ui";
import { buttonVariants } from "@assets/components/ui/button";
import { cn } from "@assets/lib/utils";

export interface Props {
  currentPage?: "home" | "about" | "projects" | "contact";
  lang?: Language;
}

const { currentPage = "home", lang = "en" } = Astro.props;
const t = useTranslations(lang);

// Helper function to generate language-aware URLs
const getUrl = (path: string) => `/${lang}${path}`;

// Get alternate language (switch between en/es)
const alternateLang = lang === "en" ? "es" : "en";
const alternateLangUrl = getAlternateLangUrl(Astro.url, alternateLang);
---

<header
  class="sticky top-0 z-50 flex items-center justify-between whitespace-nowrap border-b px-4 md:px-10 py-3 backdrop-blur-md bg-background/80"
>
  <a href={getUrl("/")} class="flex items-center gap-4 group">
    <div class="size-6 text-primary">
      <!-- I don't like this bottom/right thing, but hey, looks fine on mobile and web so 11/10 -->
      <Logo class="relative w-10 h-10 bottom-2 right-3" />
    </div>
    <div class="relative overflow-hidden">
      <h2
        class="text-lg font-bold leading-tight tracking-[-0.015em] transition-transform duration-300 group-hover:-translate-y-full"
      >
        Rafael Sanchez Martinez
      </h2>
      <span
        class="absolute top-0 left-0 text-lg font-bold leading-tight tracking-[-0.015em] text-primary transform translate-y-full transition-transform duration-300 group-hover:translate-y-0"
      >
        aka ARKye03
      </span>
    </div>
  </a>
  <div class="hidden md:flex flex-1 justify-end gap-8">
    <div class="flex items-center gap-9">
      <a
        class={`text-sm font-medium leading-normal transition-colors ${
          currentPage === "home" ? "text-primary" : "hover:text-primary"
        }`}
        href={getUrl("/")}
      >
        {t("nav.home")}
      </a>
      <a
        class={`text-sm font-medium leading-normal transition-colors ${
          currentPage === "about" ? "text-primary" : "hover:text-primary"
        }`}
        href={getUrl("/about")}
      >
        {t("nav.about")}
      </a>
      <a
        class={`text-sm font-medium leading-normal transition-colors ${
          currentPage === "projects" ? "text-primary" : "hover:text-primary"
        }`}
        href={getUrl("/projects")}
      >
        {t("nav.projects")}
      </a>
    </div>
    <a
      class={cn(buttonVariants({ variant: "default" }), "min-w-[84px]")}
      href={getUrl("/get-in-touch")}
    >
      <span class="truncate">{t("nav.contact")}</span>
    </a>
    <!-- Language Switcher -->
    <div class="flex items-center border-l ml-2 pl-6">
      <a
        href={alternateLangUrl}
        class="text-sm font-bold uppercase tracking-widest text-muted-foreground hover:text-primary transition-colors"
        title={`Switch to ${languages[alternateLang]}`}
      >
        {alternateLang}
      </a>
    </div>
  </div>
  <details class="md:hidden relative group">
    <summary class="p-2 cursor-pointer list-none" aria-label="Toggle menu">
      <span class="text-xl group-open:hidden">☰</span>
      <span class="text-xl hidden group-open:inline">✕</span>
    </summary>

    <nav
      class="absolute right-0 top-full mt-2 w-48 bg-popover border rounded-lg shadow-lg z-50"
    >
      <div class="flex flex-col py-2">
        <a
          class={cn(
            "px-4 py-3 text-sm font-medium hover:bg-accent transition-colors rounded-md",
            currentPage === "home" && "text-primary",
          )}
          href={getUrl("/")}
        >
          {t("nav.home")}
        </a>
        <a
          class={cn(
            "px-4 py-3 text-sm font-medium hover:bg-accent transition-colors rounded-md",
            currentPage === "about" && "text-primary",
          )}
          href={getUrl("/about")}
        >
          {t("nav.about")}
        </a>
        <a
          class={cn(
            "px-4 py-3 text-sm font-medium hover:bg-accent transition-colors rounded-md",
            currentPage === "projects" && "text-primary",
          )}
          href={getUrl("/projects")}
        >
          {t("nav.projects")}
        </a>
        <a
          class={cn(buttonVariants({ variant: "default" }), "mx-2 my-2")}
          href={getUrl("/get-in-touch")}
        >
          {t("nav.contact")}
        </a>
        <!-- Language Switcher -->
        <div class="px-4 py-3 mt-2 border-t">
          <a
            href={alternateLangUrl}
            class="text-sm font-medium text-muted-foreground hover:text-primary transition-colors flex items-center gap-2"
          >
            <span>🌐</span>
            <span class="uppercase">{languages[alternateLang]}</span>
          </a>
        </div>
      </div>
    </nav>
  </details>
</header>
