---
import { Icon } from "astro-icon/components";
import {
  useTranslations,
  getAlternateLangUrl,
  type Language,
} from "../i18n/utils";
import { languages } from "../i18n/ui";

export interface Props {
  currentPage?: "home" | "about" | "projects" | "contact";
  lang?: Language;
}

const { currentPage = "home", lang = "en" } = Astro.props;
const t = useTranslations(lang);

const getUrl = (path: string) => `/${lang}${path}`;
const alternateLang = lang === "en" ? "es" : "en";
const alternateLangUrl = getAlternateLangUrl(Astro.url, alternateLang);

const links = [
  { id: "home", label: t("nav.home"), href: getUrl("/") },
  { id: "projects", label: t("nav.projects"), href: getUrl("/projects") },
  { id: "about", label: t("nav.about"), href: getUrl("/about") },
  { id: "contact", label: t("nav.contact"), href: getUrl("/get-in-touch") },
] as const;
---

<header class="site-header">
  <div
    class="mx-auto flex h-full max-w-[1120px] items-center justify-between px-6"
  >
    <a
      href={getUrl("/")}
      class="font-display flex items-center gap-1 text-lg font-bold tracking-[-0.02em] no-underline"
      style="color: var(--foreground)"
    >
      <span style="color: var(--primary)">R</span>S
      <span class="mx-1 opacity-30">/</span>
      <span class="text-[13px] font-normal opacity-50">dev</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={["nav-link", { "is-active": currentPage === l.id }]}
          >
            {l.label}
          </a>
        ))
      }
      <a
        href={alternateLangUrl}
        class="ml-2 rounded-[var(--radius)] border px-3 py-1 font-mono text-xs tracking-wider uppercase transition-colors"
        style="color: var(--muted-foreground); border-color: var(--border)"
        title={`Switch to ${languages[alternateLang]}`}
      >
        {alternateLang}
      </a>
    </nav>

    <details class="group relative md:hidden">
      <summary
        class="cursor-pointer list-none p-2"
        aria-label="Toggle menu"
        style="color: var(--foreground)"
      >
        <Icon name="menu" class="h-6 w-6 group-open:hidden" />
        <Icon name="x" class="hidden h-6 w-6 group-open:inline-block" />
      </summary>

      <nav
        class="absolute top-full right-0 z-50 mt-2 flex w-56 flex-col gap-1 rounded-[var(--radius)] border p-3 shadow-lg"
        style="background: var(--card); border-color: var(--border)"
      >
        {
          links.map((l) => (
            <a
              href={l.href}
              class:list={[
                "nav-link rounded-[var(--radius)] px-3 py-2",
                { "is-active": currentPage === l.id },
              ]}
            >
              {l.label}
            </a>
          ))
        }
        <a
          href={alternateLangUrl}
          class="nav-link mt-2 rounded-[var(--radius)] border px-3 py-2"
          style="border-color: var(--border)"
        >
          {languages[alternateLang]}
        </a>
      </nav>
    </details>
  </div>
</header>

<script is:inline define:vars={{ lang }}>
  document.cookie = `lang=${lang}; path=/; max-age=31536000; samesite=lax`;
</script>
