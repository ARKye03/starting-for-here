---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div>
  <h3 class="display-h3 mb-4">{t("about.philosophy.title")}</h3>
  <p
    class="mb-4 text-[15px] leading-[1.75]"
    style="color: var(--muted-foreground); font-family: var(--font-body)"
  >
    {t("about.philosophy.p1")}
  </p>
  <p
    class="mb-4 text-[15px] leading-[1.75]"
    style="color: var(--muted-foreground); font-family: var(--font-body)"
  >
    {t("about.philosophy.p2")}
  </p>
  <p
    class="text-[15px] leading-[1.75]"
    style="color: var(--muted-foreground); font-family: var(--font-body)"
  >
    {t("about.philosophy.p3")}
  </p>
</div>
