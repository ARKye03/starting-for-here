---
import { Image } from "astro:assets";

import angularSvg from "@assets/aboutSVGs/brand-angular.svg";
import astroSvg from "@assets/aboutSVGs/brand-astro.svg";
import reactSvg from "@assets/aboutSVGs/brand-react.svg";
import dotnetSvg from "@assets/aboutSVGs/dotnet-tile.svg";
import sqlSvg from "@assets/aboutSVGs/sql.svg";
import javascriptSvg from "@assets/aboutSVGs/brand-javascript.svg";
import typescriptSvg from "@assets/aboutSVGs/brand-typescript.svg";
import desktopSvg from "@assets/aboutSVGs/device-imac.svg";
import gitSvg from "@assets/aboutSVGs/brand-git.svg";
import awsSvg from "@assets/aboutSVGs/brand-aws.svg";
import cfSvg from "@assets/aboutSVGs/brand-cloudflare.svg";
import gnomeSvg from "@assets/aboutSVGs/brand-gnome.svg";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section>
  <h2 class="text-white text-3xl font-bold leading-tight px-4 pb-3 pt-10">
    {t("about.skills.title")}
  </h2>
  <div class="grid grid-cols-2 md:grid-cols-3 gap-4 px-4 py-8">
    <div class="bg-[#191121] p-4 rounded-lg flex items-center gap-3">
      <span class="text-primary text-2xl">🎨</span>
      <p class="text-white text-base font-medium">{t("about.skills.uiux")}</p>
    </div>
    <div class="bg-[#191121] p-4 rounded-lg flex items-center gap-3">
      <span class="text-primary text-2xl">🐧</span>
      <p class="text-white text-base font-medium">{t("about.skills.linux")}</p>
    </div>
    <div class="bg-[#191121] p-4 rounded-lg flex items-center gap-3">
      <span class="text-primary text-2xl">💻</span>
      <p class="text-white text-base font-medium">
        {t("about.skills.prototype")}
      </p>
    </div>
    <div class="bg-[#191121] p-4 rounded-lg flex items-center gap-3">
      <span class="text-primary text-2xl">👥</span>
      <p class="text-white text-base font-medium">
        {t("about.skills.research")}
      </p>
    </div>
    <div class="bg-[#191121] p-4 rounded-lg flex items-center gap-3">
      <span class="text-primary text-2xl">🗣️</span>
      <p class="text-white text-base font-medium">{t("about.skills.comm")}</p>
    </div>
    <div class="bg-[#191121] p-4 rounded-lg flex items-center gap-3">
      <span class="text-primary text-2xl">💡</span>
      <p class="text-white text-base font-medium">
        {t("about.skills.problem")}
      </p>
    </div>
  </div>
</section>

<section>
  <h2 class="text-white text-3xl font-bold leading-tight px-4 pb-3 pt-10">
    {t("about.skills.stack")}
  </h2>
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 px-4 py-8">
    <div class="bg-[#191121] p-4 rounded-lg flex items-center gap-3">
      <Image src={cfSvg} alt="Cloudflare" loading="lazy" />
      <p class="text-white text-base font-medium">Cloudflare</p>
    </div>
    <div class="bg-[#191121] p-4 rounded-lg flex items-center gap-3">
      <Image src={awsSvg} alt="AWS" loading="lazy" />
      <p class="text-white text-base font-medium">AWS</p>
    </div>
    <div class="bg-[#191121] p-4 rounded-lg flex items-center gap-3">
      <Image src={angularSvg} alt="Angular" loading="lazy" />
      <p class="text-white text-base font-medium">Angular</p>
    </div>
    <div class="bg-[#191121] p-4 rounded-lg flex items-center gap-3">
      <Image src={astroSvg} alt="Astro" loading="lazy" />
      <p class="text-white text-base font-medium">Astro</p>
    </div>
    <div class="bg-[#191121] p-4 rounded-lg flex items-center gap-3">
      <Image src={reactSvg} alt="React" loading="lazy" />
      <p class="text-white text-base font-medium">React</p>
    </div>
    <div class="bg-[#191121] p-4 rounded-lg flex items-center gap-3">
      <Image src={dotnetSvg} alt=".NET" loading="lazy" />
      <p class="text-white text-base font-medium">.NET</p>
    </div>
    <div class="bg-[#191121] p-4 rounded-lg flex items-center gap-3">
      <Image src={sqlSvg} alt="SQL" loading="lazy" />
      <p class="text-white text-base font-medium">SQL Databases</p>
    </div>
    <div class="bg-[#191121] p-4 rounded-lg flex items-center gap-3">
      <Image src={javascriptSvg} alt="JavaScript" loading="lazy" />
      <p class="text-white text-base font-medium">JavaScript</p>
    </div>
    <div class="bg-[#191121] p-4 rounded-lg flex items-center gap-3">
      <Image src={typescriptSvg} alt="TypeScript" loading="lazy" />
      <p class="text-white text-base font-medium">TypeScript</p>
    </div>
    <div class="bg-[#191121] p-4 rounded-lg flex items-center gap-3">
      <Image src={gnomeSvg} alt="Gnome Tools" loading="lazy" width={24} />
      <p class="text-white text-base font-medium">Gnome Tools</p>
    </div>
    <div class="bg-[#191121] p-4 rounded-lg flex items-center gap-3">
      <Image src={desktopSvg} alt="Desktop Apps" loading="lazy" />
      <p class="text-white text-base font-medium">Desktop Apps</p>
    </div>
    <div class="bg-[#191121] p-4 rounded-lg flex items-center gap-3">
      <Image src={gitSvg} alt="Git" loading="lazy" />
      <p class="text-white text-base font-medium">Git</p>
    </div>
  </div>
  <h2 class="text-white text-3xl font-bold leading-tight px-4 pb-3 pt-10">
    {t("about.skills.languages")}
  </h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 px-4 py-8">
    <div class="bg-[#191121] p-4 rounded-lg flex flex-col items-start gap-2">
      <p class="text-white text-lg font-medium">{t("about.skills.spanish")}</p>
      <p class="text-slate-300 text-sm">{t("about.skills.native")}</p>
      <div class="w-full bg-[#302938] rounded-full h-2 mt-1">
        <div class="bg-primary h-2 rounded-full" style="width: 100%"></div>
      </div>
    </div>
    <div class="bg-[#191121] p-4 rounded-lg flex flex-col items-start gap-2">
      <p class="text-white text-lg font-medium">{t("about.skills.english")}</p>
      <p class="text-slate-300 text-sm">{t("about.skills.fluent")}</p>
      <div class="w-full bg-[#302938] rounded-full h-2 mt-1">
        <div class="bg-primary h-2 rounded-full" style="width: 85%"></div>
      </div>
    </div>
    <div class="bg-[#191121] p-4 rounded-lg flex flex-col items-start gap-2">
      <p class="text-white text-lg font-medium">{t("about.skills.german")}</p>
      <p class="text-slate-300 text-sm">{t("about.skills.basic")}</p>
      <div class="w-full bg-[#302938] rounded-full h-2 mt-1">
        <div class="bg-primary h-2 rounded-full" style="width: 30%"></div>
      </div>
    </div>
  </div>
</section>
