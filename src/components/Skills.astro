---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const softSkills = [
  t("about.skills.uiux"),
  t("about.skills.linux"),
  t("about.skills.prototype"),
  t("about.skills.research"),
  t("about.skills.comm"),
  t("about.skills.problem"),
];

const techStack = [
  { name: "TypeScript", icon: "TS" },
  { name: "React", icon: "Re" },
  { name: "Astro", icon: "As" },
  { name: ".NET", icon: ".N" },
  { name: "JavaScript", icon: "JS" },
  { name: "Angular", icon: "Ng" },
  { name: "Git", icon: "Gt" },
  { name: "AWS", icon: "AW" },
  { name: "Cloudflare", icon: "CF" },
  { name: "SQL", icon: "SQ" },
  { name: "GNOME", icon: "GN" },
  { name: "Vala", icon: "Va" },
];

const langs = [
  { name: t("about.skills.spanish"), level: t("about.skills.native"), pct: 100 },
  { name: t("about.skills.english"), level: t("about.skills.fluent"), pct: 85 },
  { name: t("about.skills.german"), level: t("about.skills.basic"), pct: 30 },
];
---

<section class="px-6 py-16 md:py-20">
  <div class="mx-auto max-w-[1120px]">
    <h2 class="display-h3 mb-6 text-xl">{t("about.skills.title")}</h2>
    <div
      class="mb-12 grid gap-3"
      style="grid-template-columns: repeat(auto-fit, minmax(min(160px, 100%), 1fr))"
    >
      {
        softSkills.map((s) => (
          <div
            class="rounded-[var(--radius)] border px-5 py-4 text-[14px] transition-colors hover:border-[var(--primary)]"
            style="background: var(--card); border-color: var(--border); color: var(--foreground); font-family: var(--font-body)"
          >
            {s}
          </div>
        ))
      }
    </div>

    <h3 class="display-h3 mb-5 text-lg">{t("about.skills.stack")}</h3>
    <div
      class="mb-12 grid gap-2.5"
      style="grid-template-columns: repeat(auto-fit, minmax(min(100px, 100%), 1fr))"
    >
      {
        techStack.map((tech) => (
          <div
            class="rounded-[var(--radius)] border px-3 py-4 text-center transition-all hover:-translate-y-0.5 hover:border-[var(--primary)]"
            style="background: var(--card); border-color: var(--border)"
          >
            <div
              class="mb-1.5 font-mono text-lg font-bold"
              style="color: var(--primary)"
            >
              {tech.icon}
            </div>
            <div
              class="text-[11px]"
              style="color: var(--muted-foreground); font-family: var(--font-body)"
            >
              {tech.name}
            </div>
          </div>
        ))
      }
    </div>

    <h3 class="display-h3 mb-5 text-lg">{t("about.skills.languages")}</h3>
    <div class="flex max-w-[480px] flex-col gap-4">
      {
        langs.map((l) => (
          <div>
            <div class="mb-1.5 flex items-center justify-between">
              <span
                class="text-[14px]"
                style="color: var(--foreground); font-family: var(--font-body)"
              >
                {l.name}
              </span>
              <span
                class="font-mono text-xs"
                style="color: var(--muted-foreground)"
              >
                {l.level}
              </span>
            </div>
            <div
              class="h-1 overflow-hidden rounded"
              style="background: var(--border)"
            >
              <div
                class="h-full rounded"
                style={`width: ${l.pct}%; background: var(--primary); animation: lang-bar-fill 1s cubic-bezier(.22,1,.36,1) both`}
              />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
