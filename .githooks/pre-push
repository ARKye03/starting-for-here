#!/usr/bin/env sh

# Git pre-push hook
# Runs TypeScript typecheck and linter before allowing a push.
# ln -s ../../.githooks/pre-push .git/hooks/pre-push

set -e

echo "Running pre-push hook..."

echo "Running TypeScript check (pnpm check)..."
pnpm check

echo "Running linter (pnpm lint)..."
pnpm lint

echo "Running formatter (pnpm fmt)..." 
pnpm fmt

echo "Pre-push hook completed."
